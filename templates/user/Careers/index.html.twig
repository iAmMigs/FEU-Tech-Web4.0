{% extends 'base.html.twig' %}

{% block title %}Careers | FEU Institute of Technology{% endblock %}

{% block body %}
<style>
    :root {
        --feu-green: #008348;
        --feu-yellow: #febe10;
    }

    html {
        scroll-behavior: smooth;
    }

    /* Modal Animation */
    .modal-enter {
        opacity: 0;
        transform: scale(0.95);
    }
    .modal-enter-active {
        opacity: 1;
        transform: scale(1);
        transition: opacity 300ms ease-out, transform 300ms ease-out;
    }
    .modal-exit {
        opacity: 1;
        transform: scale(1);
    }
    .modal-exit-active {
        opacity: 0;
        transform: scale(0.95);
        transition: opacity 200ms ease-in, transform 200ms ease-in;
    }
</style>

<section class="relative w-full py-24 min-h-[500px] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 z-0">
        <img src="/images/facility/campus_facilities_1.jpg" alt="Campus Facilities" class="w-full h-full object-cover">
        <div class="absolute inset-0 bg-[#008348] opacity-80 mix-blend-multiply"></div>
        <div class="absolute inset-0 bg-[#008348] opacity-40"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full flex flex-col md:flex-row items-center justify-between gap-12">
        <div class="md:w-1/2 text-left">
            <span class="text-feu-yellow font-black tracking-[0.3em] uppercase text-sm mb-4 block drop-shadow-md">
                {{ content.careers_badge }}
            </span>
            <h1 class="text-6xl md:text-8xl font-black text-feu-yellow leading-none tracking-tighter mb-2 drop-shadow-lg">
                {{ content.careers_title_yellow }}
            </h1>
            <h1 class="text-7xl md:text-9xl font-black text-white leading-none tracking-tighter mb-6 drop-shadow-lg">
                {{ content.careers_title_white }}
            </h1>
            <p class="text-green-50 text-xl font-medium max-w-lg leading-relaxed mb-8">
                {{ content.careers_subtitle }}
            </p>
            <a href="#open-positions" class="inline-flex items-center gap-2 bg-feu-yellow text-slate-900 px-8 py-4 rounded-full font-black uppercase tracking-wider hover:bg-white transition-colors shadow-xl hover:shadow-2xl transform hover:-translate-y-1 duration-300">
                {{ content.careers_button_text }}
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
            </a>
        </div>
        
        <div class="md:w-1/2 relative hidden md:block">
            <div class="relative w-full h-[450px] flex items-end justify-center">
                <img src="/images/Tamtam/OFFICE_TAMMY.png" alt="Megaphone Tammy" class="relative z-10 w-[400px] h-auto drop-shadow-2xl transform hover:scale-105 transition-transform duration-500">
            </div>
        </div>
    </div>
</section>

<section id="open-positions" class="py-24 bg-slate-50 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
            <h2 class="text-4xl font-black text-slate-900 uppercase tracking-tight mb-4">Current Opportunities</h2>
            <div class="w-16 h-1 bg-feu-green mx-auto rounded-full mb-6"></div>
            <p class="text-slate-600 text-lg max-w-2xl mx-auto">Click on a position to view full qualifications and details.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
            
            {% for job in jobs %}
            <button onclick="openModal('job-{{ job.id }}')" class="job-card group relative bg-white rounded-3xl p-8 border border-slate-200 shadow-sm hover:shadow-2xl hover:border-feu-green/50 transition-all duration-300 text-left overflow-hidden flex flex-col justify-between min-h-[250px]">
                
                <div class="absolute -bottom-10 right-0 w-32 h-32 opacity-0 group-hover:opacity-100 group-hover:-translate-y-6 transition-all duration-500 ease-out z-0 pointer-events-none">
                    <img src="{{ '/' in job.mascot ? job.mascot : '/images/HRO/HRTAMTAM/' ~ job.mascot }}" alt="Mascot" class="w-full h-full object-contain drop-shadow-xl transform group-hover:scale-110 transition-transform duration-700">
                </div>

                <div class="relative z-10">
                    <div class="flex items-center gap-3 mb-6">
                        <span class="px-3 py-1 bg-slate-100 text-slate-600 text-xs font-bold uppercase tracking-wider rounded-full">{{ job.department }}</span>
                        <span class="px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-full {{ job.type == 'Part Time' ? 'bg-amber-100 text-amber-700 border border-amber-200' : 'bg-emerald-100 text-emerald-700 border border-emerald-200' }}">{{ job.type }}</span>
                    </div>
                    
                    <h3 class="text-2xl md:text-3xl font-black text-slate-900 group-hover:text-feu-green transition-colors leading-tight pr-20">{{ job.title }}</h3>
                </div>

                <div class="mt-8 flex items-center justify-between relative z-10">
                    <span class="text-feu-green font-bold uppercase tracking-widest text-sm flex items-center gap-2 group-hover:translate-x-2 transition-transform duration-300">
                        View Details
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                    </span>
                </div>
            </button>

            <div id="job-{{ job.id }}" class="job-modal fixed inset-0 z-[9999] hidden overflow-y-auto p-4 sm:p-6 md:p-10 flex justify-center items-start md:items-center">
                <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm modal-backdrop transition-opacity duration-300 opacity-0" onclick="closeModal('job-{{ job.id }}')"></div>
                
                <div class="relative w-full max-w-3xl my-auto bg-white rounded-3xl shadow-2xl overflow-hidden flex flex-col transition-all duration-300 transform scale-95 opacity-0 modal-panel z-10">
                    
                    <div class="bg-slate-50 border-b border-slate-100 p-6 md:p-8 relative flex-shrink-0">
                        <button onclick="closeModal('job-{{ job.id }}')" class="absolute top-6 right-6 w-10 h-10 bg-white rounded-full flex items-center justify-center text-slate-400 hover:text-red-500 hover:bg-red-50 shadow-sm transition-colors z-20">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                        </button>
                        
                        <div class="flex items-center gap-3 mb-4 pr-12">
                            <span class="px-3 py-1 bg-white border border-slate-200 text-slate-600 text-xs font-bold uppercase tracking-wider rounded-full shadow-sm">{{ job.department }}</span>
                            <span class="px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-full {{ job.type == 'Part Time' ? 'bg-amber-100 text-amber-700 border border-amber-200' : 'bg-emerald-100 text-emerald-700 border border-emerald-200' }}">{{ job.type }}</span>
                        </div>
                        <h2 class="text-2xl md:text-4xl font-black text-slate-900 pr-12 leading-tight">{{ job.title }}</h2>
                    </div>

                    <div class="p-6 md:p-8 overflow-y-auto max-h-[60vh] md:max-h-[70vh] flex-grow">
                        {% if job.image is not null %}
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
                                <div class="flex flex-col items-center justify-center bg-slate-50 rounded-2xl p-4 border border-slate-100 shadow-inner group">
                                    <div class="relative overflow-hidden rounded-xl border border-slate-200 shadow-sm transition-transform duration-300 group-hover:scale-[1.02] cursor-pointer w-full" 
                                         onclick="openLightbox('{{ '/' in job.image ? job.image : '/images/HRO/' ~ job.image }}')">
                                        <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center z-10">
                                            <svg class="w-12 h-12 text-white drop-shadow-lg" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path></svg>
                                        </div>
                                        <img src="{{ '/' in job.image ? job.image : '/images/HRO/' ~ job.image }}" alt="Official Job Posting Poster" class="w-full h-auto max-h-[250px] md:max-h-[500px] object-contain relative z-0 mx-auto">
                                    </div>
                                    <p class="text-xs text-slate-400 mt-3 flex items-center gap-1 font-medium tracking-wide">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                                        Official HRO Posting Poster
                                    </p>
                                </div>
                                
                                <div class="flex flex-col">
                                    <h4 class="text-xl font-bold text-slate-800 mb-4 flex items-center gap-2 flex-shrink-0">
                                        <svg class="w-6 h-6 text-feu-yellow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                        Qualifications:
                                    </h4>
                                    
                                    <div>
                                        <ul class="space-y-4 pb-2">
                                            {% for qual in job.qualifications %}
                                            <li class="flex items-start gap-3 text-slate-600 leading-relaxed">
                                                <div class="mt-1.5 w-1.5 h-1.5 rounded-full bg-feu-green flex-shrink-0"></div>
                                                <span>{{ qual.qualification }}</span>
                                            </li>
                                            {% endfor %}
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        {% else %}
                            <div class="flex flex-col">
                                <h4 class="text-xl font-bold text-slate-800 mb-4 flex items-center gap-2 flex-shrink-0">
                                    <svg class="w-6 h-6 text-feu-yellow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                    Qualifications:
                                </h4>
                                
                                <div class="overflow-y-auto pr-2 max-h-[350px] md:max-h-[450px] scrollbar-thin scrollbar-thumb-slate-200 hover:scrollbar-thumb-slate-300">
                                    <ul class="space-y-4 pb-2">
                                        {% for qual in job.qualifications %}
                                        <li class="flex items-start gap-3 text-slate-600 leading-relaxed">
                                            <div class="mt-1.5 w-1.5 h-1.5 rounded-full bg-feu-green flex-shrink-0"></div>
                                            <span>{{ qual.qualification }}</span>
                                        </li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            </div>
                        {% endif %}
                    </div>

                    <div class="bg-slate-50 border-t border-slate-100 p-6 flex items-center justify-between flex-shrink-0">
                        <p class="text-slate-500 text-sm hidden md:block">Ready to join our team?</p>
                        <a href="#how-to-apply" onclick="closeModal('job-{{ job.id }}')" class="w-full md:w-auto text-center px-8 py-3 bg-feu-green text-white font-bold uppercase tracking-wider rounded-full hover:bg-green-700 shadow-lg hover:shadow-xl transition-all">
                            Apply Now
                        </a>
                    </div>
                </div>
            </div>
            {% endfor %}

        </div>
    </div>
</section>

<section id="how-to-apply" class="py-24 bg-white relative border-t border-slate-100 overflow-hidden">
    <div class="absolute left-0 bottom-0 w-64 h-64 bg-feu-yellow/10 rounded-tr-full z-0"></div>
    
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
        <h2 class="text-4xl font-black text-slate-900 uppercase tracking-tight mb-8">How to Apply</h2>
        
        <div class="bg-feu-yellow/20 border-2 border-feu-yellow p-10 md:p-12 rounded-3xl inline-block max-w-2xl w-full shadow-lg">
            <p class="text-xl text-slate-800 font-medium mb-6">For interested applicants, send your resume to:</p>
            
            <a href="mailto:{{ content.careers_hr_email }}" class="text-3xl md:text-4xl font-black text-feu-green hover:underline decoration-4 underline-offset-4 mb-8 block drop-shadow-sm">
                {{ content.careers_hr_email }}
            </a>
            
            <div class="bg-white/60 backdrop-blur-sm rounded-2xl p-6 border border-white">
                <p class="text-slate-600 font-semibold mb-2 uppercase tracking-widest text-sm">With the following subject line:</p>
                <code class="text-lg md:text-xl font-bold text-slate-900 bg-white px-4 py-2 rounded-lg border border-slate-200 shadow-sm block break-all">
                    {{ content.careers_subject_format }}
                </code>
            </div>
        </div>
        
        <p class="mt-12 text-slate-500 font-medium italic">
            Technology Driven By Innovation<br>
            <span class="text-feu-green font-bold">#TheSchoolofInnovation</span>
        </p>
    </div>
</section>

<div id="image-lightbox" class="fixed inset-0 z-[10000] hidden flex items-center justify-center bg-slate-900/90 backdrop-blur-sm transition-opacity duration-300 opacity-0" onclick="closeLightbox()">
    <button class="absolute top-6 right-6 w-12 h-12 bg-white/10 hover:bg-white/20 rounded-full flex items-center justify-center text-white transition-colors">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>
    <img id="lightbox-img" src="" alt="Enlarged Poster" class="max-w-[95vw] max-h-[95vh] object-contain transform scale-95 transition-transform duration-300 shadow-2xl rounded-lg">
</div>

<script>
    function openModal(id) {
        const modal = document.getElementById(id);
        if(!modal) return;
        const backdrop = modal.querySelector('.modal-backdrop');
        const panel = modal.querySelector('.modal-panel');
        
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        
        void modal.offsetWidth;
        
        backdrop.classList.remove('opacity-0');
        backdrop.classList.add('opacity-100');
        
        panel.classList.remove('scale-95', 'opacity-0');
        panel.classList.add('scale-100', 'opacity-100');
        
        document.body.style.overflow = 'hidden';
    }

    function closeModal(id) {
        const modal = document.getElementById(id);
        if(!modal) return;
        const backdrop = modal.querySelector('.modal-backdrop');
        const panel = modal.querySelector('.modal-panel');
        
        backdrop.classList.remove('opacity-100');
        backdrop.classList.add('opacity-0');
        
        panel.classList.remove('scale-100', 'opacity-100');
        panel.classList.add('scale-95', 'opacity-0');
        
        document.body.style.overflow = '';
        
        setTimeout(() => {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }, 300);
    }

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            const openModals = document.querySelectorAll('.job-modal:not(.hidden)');
            openModals.forEach(modal => closeModal(modal.id));
            
            const lightbox = document.getElementById('image-lightbox');
            if (!lightbox.classList.contains('hidden')) {
                closeLightbox();
            }
        }
    });

    function openLightbox(src) {
        const lightbox = document.getElementById('image-lightbox');
        const img = document.getElementById('lightbox-img');
        img.src = src;
        
        lightbox.classList.remove('hidden');
        void lightbox.offsetWidth;
        
        lightbox.classList.remove('opacity-0');
        lightbox.classList.add('opacity-100');
        
        img.classList.remove('scale-95');
        img.classList.add('scale-100');
    }

    function closeLightbox() {
        const lightbox = document.getElementById('image-lightbox');
        const img = document.getElementById('lightbox-img');
        
        lightbox.classList.remove('opacity-100');
        lightbox.classList.add('opacity-0');
        
        img.classList.remove('scale-100');
        img.classList.add('scale-95');
        
        setTimeout(() => {
            lightbox.classList.add('hidden');
        }, 300);
    }
</script>
{% endblock %}