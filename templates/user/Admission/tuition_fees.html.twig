{% extends 'base.html.twig' %}

{% block title %}Tuition & Fees Payment | FEU Institute of Technology{% endblock %}

{% block body %}

<!-- Hero Section -->
<section class="relative w-full h-[50vh] min-h-[400px] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 z-0">
        <img src="{{ page and page.heroImage ? (page.heroImage == 'FEU-TECHBLD.jpg' ? '/images/' ~ page.heroImage : (page.heroImage starts with 'uploads/' ? '/' ~ page.heroImage : '/uploads/admissions/' ~ page.heroImage)) : '/images/FEU-TECHBLD.jpg' }}" alt="FEU Tech Building" class="w-full h-full object-cover transform scale-105">
        <div class="absolute inset-0 bg-slate-900/75 mix-blend-multiply"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-transparent to-transparent opacity-80"></div>
        <div class="absolute bottom-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#008348] via-[#febe10] to-[#008348]"></div>
    </div>

    <div class="relative z-10 text-center px-5 max-w-4xl mx-auto">
        <span class="text-feu-yellow font-bold tracking-widest uppercase text-sm mb-4 block">
            Admissions
        </span>
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-black text-white leading-tight drop-shadow-2xl uppercase tracking-wider mb-4">
            {{ page and page.heroTitle ? page.heroTitle : 'Tuition & Fees' }}
        </h1>
        <p class="text-slate-300 text-lg md:text-xl font-light max-w-2xl mx-auto">
            {{ page and page.heroDescription ? page.heroDescription : 'Convenient and secure payment options for your educational journey.' }}
        </p>
    </div>
</section>

<!-- Bank Navigation Area -->
<div class="bg-white border-b border-slate-200 shadow-sm relative z-20 -mt-6 mx-4 sm:mx-8 max-w-5xl lg:mx-auto rounded-t-2xl">
    <div class="p-6">
        <h2 class="text-lg font-bold text-slate-700 mb-4 text-center uppercase tracking-wide">Select Payment Method</h2>
        <div class="flex flex-wrap justify-center gap-4" id="bank-nav">
            
            {% for option in paymentOptions %}
            <button data-target="bank-{{ option.slug }}" 
                    style="--hover-color: {{ option.themeColor }};"
                    class="bank-btn group relative flex flex-col items-center justify-center p-6 rounded-xl border-2 border-slate-100 bg-slate-50 hover:border-[var(--hover-color)] hover:bg-white hover:shadow-lg transition-all duration-300 w-[calc(50%-0.5rem)] md:w-auto md:min-w-[160px]">
                <div class="w-12 h-12 rounded-full flex items-center justify-center mb-3 group-hover:scale-110 transition-transform" 
                     style="background-color: {{ option.themeColor }}20;">
                    <span style="color: {{ option.themeColor }};" class="font-bold text-xl">{{ option.logoText }}</span>
                </div>
                <span class="font-semibold text-slate-700 group-hover:text-[var(--hover-color)] text-center">{{ option.name }}</span>
            </button>
            {% endfor %}
            
        </div>
    </div>
</div>

<!-- Main Content Area -->
<div class="bg-[#f8fafc] py-16 min-h-[400px]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Default State (No Bank Selected) -->
        <div id="bank-default" class="content-section flex flex-col items-center justify-center py-20 text-center animate-fade-in-up">
            <div class="w-24 h-24 bg-slate-100 rounded-full flex items-center justify-center mb-6">
                <svg class="w-12 h-12 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
            </div>
            <h3 class="text-2xl font-bold text-slate-500">Please select a payment method you wish to know.</h3>
            <p class="text-slate-400 mt-2">Click on one of the banks above to view detailed instructions.</p>
        </div>

        {% for option in paymentOptions %}
        <div id="bank-{{ option.slug }}" class="content-section hidden py-8 animate-fade-in-up">
            <div class="bg-white rounded-3xl p-8 md:p-12 shadow-sm border-t-8" style="border-top-color: {{ option.themeColor }};">
                <h3 class="text-3xl font-extrabold mb-8 flex items-center gap-4" style="color: {{ option.themeColor }};">
                    {{ option.name }}
                </h3>
                
                {% if option.showComputation %}
                    <div class="bg-blue-50 p-6 rounded-2xl mb-10 border border-blue-100">
                        <h4 class="font-bold text-slate-800 mb-2">Sample Computation</h4>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm text-slate-600">
                            <div>
                                <div class="flex justify-between mb-1"><span>Enrollment Fee:</span> <strong>{{ option.computationFee }}</strong></div>
                                <div class="flex justify-between mb-1"><span>Divided by {{ option.computationDivisor }}:</span> <strong>{{ option.computationTotal }}</strong></div>
                            </div>
                            <div class="border-t sm:border-t-0 sm:border-l border-blue-200 sm:pl-4 pt-2 sm:pt-0">
                                <div class="flex justify-between text-[#007DFE] mb-1"><span>Amount to be paid:</span> <strong>{{ option.computationTotal }}</strong></div>
                                <div class="flex justify-between mb-1"><span>Amount in Official Receipt:</span> <strong>{{ option.computationFee }}</strong></div>
                                <div class="text-xs text-slate-500 mt-1 italic">The {{ option.computationProcessingFee }} is the processing fee.</div>
                            </div>
                        </div>
                    </div>
                {% endif %}

                {% if option.additionalInfo %}
                    <div class="bg-slate-50 p-6 rounded-2xl mb-10 border border-slate-100">
                        {{ option.additionalInfo|raw }}
                    </div>
                {% endif %}
                
                {% if option.instructionsImage %}
                    <div class="mb-10 overflow-hidden rounded-2xl border border-slate-200 shadow-sm">
                        <img src="{{ option.instructionsImage starts with 'Payments/' ? '/images/' ~ option.instructionsImage : '/uploads/payments/' ~ option.instructionsImage }}" alt="{{ option.name }} Instructions" class="w-full h-auto object-contain">
                    </div>
                {% endif %}

                {% if option.merchantName %}
                    <div class="p-6 rounded-2xl mb-8" style="background-color: {{ option.themeColor }}10;">
                        <p class="font-semibold text-slate-800">Merchant Name:</p>
                        <p class="text-lg font-bold uppercase tracking-wider" style="color: {{ option.themeColor }};">{{ option.merchantName }}</p>
                    </div>
                {% endif %}

                {% if option.importantReminders and option.importantReminders is not empty %}
                    <h4 class="text-xl font-bold text-slate-800 mb-6">Important Reminders</h4>
                    <div class="space-y-6 mb-8">
                        {% for reminder in option.importantReminders %}
                        <div class="flex">
                            <div class="flex-shrink-0 mt-1">
                                <div class="w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 font-bold">{{ loop.index }}</div>
                            </div>
                            <div class="ml-4">
                                <p class="text-slate-600 font-medium">{{ reminder }}</p>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                {% endif %}

                {% if option.steps and option.steps is not empty %}
                    <h4 class="text-xl font-bold text-slate-800 mb-6">Step-by-Step Guide</h4>
                    
                    <div class="space-y-6 relative z-10">
                        {% for step in option.steps %}
                        <div class="bg-slate-50 p-6 rounded-2xl border border-slate-100 hover:shadow-md transition-shadow">
                            <div class="flex items-start mb-4">
                                <div class="flex-shrink-0 w-10 h-10 rounded-full flex items-center justify-center text-white font-bold text-lg shadow-md"
                                     style="background-color: {{ option.themeColor }};">
                                    {{ step.stepNumber }}
                                </div>
                                <div class="ml-4 pt-1">
                                    <h5 class="font-bold text-slate-800 text-lg">{{ step.title }}</h5>
                                    <div class="text-slate-600 mt-1">{{ step.description|raw }}</div>
                                </div>
                            </div>
                            
                            {% if step.image %}
                                {% set images = step.image|split(',') %}
                                {% if images|length > 1 %}
                                    <div class="ml-14 grid grid-cols-1 md:grid-cols-2 gap-4">
                                        {% for img in images %}
                                            <img src="{{ img starts with 'Payments/' ? '/images/' ~ img : '/uploads/payments/' ~ img }}" alt="{{ step.title }} Image {{ loop.index }}" class="w-full rounded-lg shadow-sm border border-slate-200">
                                        {% endfor %}
                                    </div>
                                {% else %}
                                    <img src="{{ step.image starts with 'Payments/' ? '/images/' ~ step.image : '/uploads/payments/' ~ step.image }}" alt="{{ step.title }}" class="w-full max-w-md rounded-lg shadow-sm border border-slate-200 ml-14">
                                {% endif %}
                            {% endif %}
                        </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
        {% endfor %}
        
    </div>
</div>

<!-- Applicable To Static Section -->
<section class="py-24 bg-white relative border-t border-slate-200 overflow-hidden">
    <!-- Background element -->
    <div class="absolute right-0 top-0 w-1/3 h-full bg-slate-50 -skew-x-12 transform origin-top translate-x-20 z-0"></div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="text-center mb-16">
            <h2 class="text-3xl font-extrabold text-slate-800 uppercase tracking-widest relative inline-block">
                Applicable To
                <div class="absolute -bottom-4 left-1/2 -translate-x-1/2 w-16 h-1 bg-feu-green rounded"></div>
            </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 items-stretch">
            
            <!-- Old Students Card -->
            <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm hover:shadow-lg transition-shadow relative overflow-hidden flex flex-col items-center text-center">
                <div class="w-16 h-16 bg-feu-green/10 rounded-full flex items-center justify-center mb-6">
                    <svg class="w-8 h-8 text-feu-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                </div>
                <h3 class="text-2xl font-bold text-slate-800 mb-4">Old Students</h3>
                <p class="text-slate-600 mb-6">Regular payment procedures apply. Please use your official Student Number for all transactions.</p>
            </div>

            <!-- New Students Card -->
            <div class="bg-feu-green rounded-3xl p-8 border border-feu-green shadow-xl relative overflow-hidden flex flex-col items-center text-center text-white">
                <div class="absolute top-0 right-0 w-32 h-32 bg-white/10 rounded-bl-full -z-0"></div>
                <div class="w-16 h-16 bg-white/20 rounded-full flex items-center justify-center mb-6 relative z-10 backdrop-blur-sm">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path></svg>
                </div>
                <h3 class="text-2xl font-bold mb-4 relative z-10">New Students</h3>
                
                <div class="space-y-4 w-full relative z-10">
                    <div class="bg-black/20 p-4 rounded-xl backdrop-blur-sm">
                        <p class="font-bold text-feu-yellow mb-1 text-sm uppercase tracking-wider">With Student Number</p>
                        <p class="text-sm opacity-90">Use your assigned Student Number.</p>
                    </div>
                    <div class="bg-white/10 p-4 rounded-xl backdrop-blur-sm border border-white/20">
                        <p class="font-bold text-white mb-1 text-sm uppercase tracking-wider">Without Student Number</p>
                        <p class="text-sm opacity-90">Use <strong class="text-feu-yellow text-base font-black">202200000</strong> as your temporary student number.</p>
                    </div>
                </div>
                
                <p class="text-xs text-center mt-6 text-emerald-100 relative z-10">
                    New students who are first-time payers and with no assigned student numbers may use the Landbank Link.Biz.Portal to pay their Reservation Fee or Downpayment.
                </p>
            </div>

        </div>
    </div>
</section>

<!-- Bank Selection Script -->
<script>
    (function() {
        function initTuitionTabs() {
            const bankBtns = document.querySelectorAll('.bank-btn');
            const contentSections = document.querySelectorAll('.content-section');

            if (!bankBtns.length) return; // Guard clause

            // Reset to default selection state on load
            contentSections.forEach(section => {
                if (section.id === 'bank-default') {
                    section.classList.remove('hidden');
                } else {
                    section.classList.add('hidden');
                }
            });
            bankBtns.forEach(b => {
                b.classList.remove('bg-white');
                b.classList.add('bg-slate-50');
                b.style.boxShadow = 'none';
                b.style.transform = 'none';
                b.style.zIndex = 'auto';
            });

            bankBtns.forEach(btn => {
                btn.onclick = () => {
                    const targetId = btn.getAttribute('data-target');
                    const hoverColor = btn.style.getPropertyValue('--hover-color') || '#000000';
                    
                    // 1. Hide all content sections
                    contentSections.forEach(section => {
                        section.classList.add('hidden');
                    });
                    
                    // 2. Remove active styling from all buttons
                    bankBtns.forEach(b => {
                        b.classList.remove('bg-white');
                        b.classList.add('bg-slate-50');
                        b.style.boxShadow = 'none';
                        b.style.transform = 'none';
                        b.style.zIndex = 'auto';
                    });

                    // 3. Show target content section
                    const targetSection = document.getElementById(targetId);
                    if (targetSection) {
                        targetSection.classList.remove('hidden');
                    }

                    // 4. Add active styling to clicked button
                    btn.classList.add('bg-white');
                    btn.classList.remove('bg-slate-50');
                    btn.style.boxShadow = `0 0 0 4px ${hoverColor}60`; // Translucent brand border ring
                    btn.style.transform = 'scale(1.02)';
                    btn.style.zIndex = '10';
                };
            });
        }

        // Initialize immediately
        initTuitionTabs();

        // Re-initialize if the page is loaded via Turbo
        document.addEventListener('turbo:load', initTuitionTabs);
    })();
</script>

{% endblock %}
