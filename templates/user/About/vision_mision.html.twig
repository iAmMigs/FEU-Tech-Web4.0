{% extends 'base.html.twig' %}

{% block body %}

<section id="top" class="relative isolate w-full min-h-[72vh] flex items-center overflow-hidden">

    <div class="absolute inset-0 z-0">
        <img src="/images/About_TECH.jpg"
             alt="Hero Background"
             class="w-full h-full object-cover scale-105">

        <div class="absolute inset-0 bg-gradient-to-br from-[#00180d]/95 via-[#002d19]/80 to-[#0f172a]/90"></div>

        <div class="absolute -top-32 -left-32 w-96 h-96 bg-feu-yellow/20 rounded-full blur-3xl"></div>
        <div class="absolute bottom-0 right-0 w-[32rem] h-[32rem] bg-feu-green/30 rounded-full blur-3xl"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-12 py-24 w-full">

        <div class="max-w-4xl">

            <h1 class="text-5xl sm:text-6xl lg:text-7xl font-black text-white leading-[0.95]">
                {{ content ? content.heroTitle : 'Vision, Mission,' }}
                <span class="block text-feu-yellow mt-2">
                    {{ content ? content.heroTitleHighlight : '& EOMS Policy' }}
                </span>
            </h1>

            <div class="mt-8 h-1.5 w-40 bg-gradient-to-r from-feu-yellow via-white to-feu-green rounded-full"></div>

            <p class="mt-8 text-lg text-slate-200 max-w-2xl font-light">
                {{ content ? content.heroDescription : 'Driven by innovation, excellence, and nation-building.' }}
            </p>

        </div>

    </div>

</section>

<section class="relative py-28 bg-gradient-to-b from-slate-50 via-white to-slate-100 overflow-hidden">

    <div class="absolute -top-32 -left-32 w-96 h-96 bg-feu-green opacity-[0.05] rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 right-0 w-[28rem] h-[28rem] bg-feu-yellow opacity-[0.06] rounded-full blur-3xl"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

        <div class="text-center mb-20">
            <span class="inline-flex items-center gap-2 px-5 py-2 rounded-full bg-feu-green/10 text-feu-green text-sm font-bold uppercase tracking-[0.2em]">
                FEU Institute of Technology
            </span>

            <h2 class="mt-6 text-4xl sm:text-5xl font-black text-slate-900 leading-tight">
                Core Institutional
                <span class="text-feu-green">Foundations</span>
            </h2>

            <p class="mt-6 max-w-3xl mx-auto text-slate-600 text-lg leading-relaxed">
                FEU Tech continuously upholds academic excellence, innovation, and transformative education
                through its guiding principles and commitment to quality learning experiences.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-14">

            <div class="group relative bg-white rounded-[2rem] border border-slate-200 shadow-xl hover:-translate-y-2 hover:shadow-[0_25px_60px_rgba(0,0,0,0.12)] hover:bg-slate-50 hover:border-slate-300 transition-all duration-500 overflow-visible">

                <div class="absolute top-0 right-0 w-32 h-32 bg-emerald-50 rounded-bl-full -z-0 transition-transform duration-500 group-hover:scale-110"></div>

                <div class="absolute inset-0 rounded-[2rem] bg-gradient-to-br from-feu-green/5 via-transparent to-feu-yellow/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>

                <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-feu-green via-feu-yellow to-feu-green"></div>

                <div class="absolute left-10 -top-12 z-20">

                    <div class="relative w-24 h-24 rounded-full bg-feu-green border-[8px] border-white shadow-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">

                        <div class="absolute inset-0 rounded-full bg-feu-green opacity-20 blur-xl"></div>

                        <svg class="relative z-10 w-10 h-10 text-white"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="8"></circle>
                            <circle cx="12" cy="12" r="4"></circle>
                            <path d="M12 2v2M12 20v2M2 12h2M20 12h2"></path>
                        </svg>

                    </div>
                </div>

                <div class="p-10 pt-20 h-full flex flex-col relative z-10">

                    <div class="flex items-center justify-between mb-8">
                        <div>
                            <p class="text-feu-green uppercase tracking-[0.25em] text-xs font-bold mb-2">
                                Institutional
                            </p>
                            <h3 class="text-3xl font-extrabold text-slate-800">
                                {{ content ? content.titleOne : 'Vision' }}
                            </h3>
                        </div>
                    </div>

                    <div class="w-16 h-1 bg-feu-green rounded-full mb-6"></div>

                    <p class="text-slate-600 leading-relaxed text-[15px] text-justify flex-grow">
                        {{ content ? content.titleOneText : 'Aims to be the global standard of innovation in education, research, and nation-building by creating the next generation of changemakers that will shape the future of the country and the world.' }}
                    </p>

                </div>
            </div>

            <div class="group relative bg-white rounded-[2rem] border border-slate-200 shadow-xl hover:-translate-y-2 hover:shadow-[0_25px_60px_rgba(0,0,0,0.12)] hover:bg-slate-50 hover:border-slate-300 transition-all duration-500 overflow-visible">

                <div class="absolute top-0 right-0 w-32 h-32 bg-emerald-50 rounded-bl-full -z-0 transition-transform duration-500 group-hover:scale-110"></div>

                <div class="absolute inset-0 rounded-[2rem] bg-gradient-to-br from-feu-yellow/5 via-transparent to-feu-green/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>

                <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-feu-yellow via-feu-green to-feu-yellow"></div>

                <div class="absolute left-10 -top-12 z-20">

                    <div class="relative w-24 h-24 rounded-full bg-feu-yellow border-[8px] border-white shadow-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">

                        <div class="absolute inset-0 rounded-full bg-feu-yellow opacity-20 blur-xl"></div>

                        <svg class="relative z-10 w-10 h-10 text-slate-900"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             viewBox="0 0 24 24">
                            <path d="M9 18h6"></path>
                            <path d="M10 22h4"></path>
                            <path d="M12 2a7 7 0 00-4 12c.6.6 1 1.3 1.2 2h5.6c.2-.7.6-1.4 1.2-2A7 7 0 0012 2z"></path>
                        </svg>

                    </div>
                </div>

                <div class="p-10 pt-20 h-full flex flex-col relative z-10">

                    <div class="flex items-center justify-between mb-8">
                        <div>
                            <p class="text-feu-yellow uppercase tracking-[0.25em] text-xs font-bold mb-2">
                                Institutional
                            </p>
                            <h3 class="text-3xl font-extrabold text-slate-800">
                                {{ content ? content.titleTwo : 'Mission' }}
                            </h3>
                        </div>
                    </div>

                    <div class="w-16 h-1 bg-feu-yellow rounded-full mb-6"></div>

                    <p class="text-slate-600 leading-relaxed text-[15px] text-justify flex-grow">
                        {{ content ? content.titleTwoText : 'Dedicated to provide quality, relevant, innovative and industry-based education producing competent and principled professionals with greater sense of responsibility, social awareness and high competitiveness contributing significantly to the betterment of the society.' }}
                    </p>

                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 mt-14">
            <div class="group relative bg-white rounded-[2rem] border border-slate-200 shadow-xl hover:-translate-y-2 hover:shadow-[0_25px_60px_rgba(0,0,0,0.12)] hover:bg-slate-50 hover:border-slate-300 transition-all duration-500 overflow-visible">

                <div class="absolute top-0 right-0 w-32 h-32 bg-emerald-50 rounded-bl-full -z-0 transition-transform duration-500 group-hover:scale-110"></div>

                <div class="absolute inset-0 rounded-[2rem] bg-gradient-to-br from-feu-green/5 via-transparent to-feu-yellow/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>

                <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-feu-green via-feu-yellow to-feu-green"></div>

                <div class="absolute left-10 -top-12 z-20">

                    <div class="relative w-24 h-24 rounded-full bg-feu-green border-[8px] border-white shadow-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">

                        <div class="absolute inset-0 rounded-full bg-feu-green opacity-20 blur-xl"></div>

                        <svg class="relative z-10 w-10 h-10 text-white"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             viewBox="0 0 24 24">
                            <path d="M9 12h6m-6 4h6M7 4h10a2 2 0 012 2v12a2 2 0 01-2 2H7a2 2 0 01-2-2V6a2 2 0 012-2z"></path>
                        </svg>
                    </div>
                </div>

                <div class="p-10 pt-20 h-full flex flex-col relative z-10">

                    <div class="flex items-center justify-between mb-8">
                        <div>
                            <p class="text-feu-green uppercase tracking-[0.25em] text-xs font-bold mb-2">
                                Educational
                            </p>
                            <h3 class="text-3xl font-extrabold text-slate-800">
                                {{ content ? content.titleThree : 'EOMS Policy' }}
                            </h3>
                        </div>
                    </div>

                    <div class="w-16 h-1 bg-feu-green rounded-full mb-6"></div>

                    <p class="text-slate-600 leading-relaxed text-[15px] text-justify flex-grow">
                        {{ content ? content.titleThreeText : 'Committed to providing innovative, industry-relevant, and learner-centered education that equips students with technical, professional, and lifelong-learning competencies for global citizenship and nation building. Guided by the core values of Fortitude, Excellence, and Uprightness, the institution fosters a community of ethical, socially responsible, and future-ready learners.' }}
                    </p>

                    <div class="py-8">
                        <h3 class="text-xl font-bold text-slate-800 leading-tight">
                            To fulfill this commitment, FEU Tech shall:
                        </h3>
                        <div class="w-16 h-1 bg-feu-yellow rounded-full"></div>
                    </div>

                    <ul class="space-y-5 text-slate-600 text-[15px]">
                        {% if content and content.titleThreeCommitments is not empty %}
                            {% for commitment in content.titleThreeCommitments %}
                                <li class="flex items-start gap-4 group/item">
                                    <div class="mt-1 w-7 h-7 rounded-full bg-emerald-50 flex items-center justify-center flex-shrink-0 border border-feu-green/10 group-hover/item:bg-feu-green transition-colors duration-300">
                                        <svg class="w-3.5 h-3.5 text-feu-green group-hover/item:text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-width="3" d="M5 13l4 4L19 7"></path>
                                        </svg>
                                    </div>
                                    <span class="leading-relaxed">
                                        {{ commitment }}
                                    </span>
                                </li>
                            {% endfor %}
                        {% else %}
                            <li class="flex items-start gap-4 group/item">
                                <div class="mt-1 w-7 h-7 rounded-full bg-emerald-50 flex items-center justify-center flex-shrink-0 border border-feu-green/10 group-hover/item:bg-feu-green transition-colors duration-300">
                                    <svg class="w-3.5 h-3.5 text-feu-green group-hover/item:text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-width="3" d="M5 13l4 4L19 7"></path>
                                    </svg>
                                </div>
                                <span class="leading-relaxed">Offer globally competitive and industry-aligned academic programs;</span>
                            </li>
                            <li class="flex items-start gap-4 group/item">
                                <div class="mt-1 w-7 h-7 rounded-full bg-emerald-50 flex items-center justify-center flex-shrink-0 border border-feu-green/10 group-hover/item:bg-feu-green transition-colors duration-300">
                                    <svg class="w-3.5 h-3.5 text-feu-green group-hover/item:text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-width="3" d="M5 13l4 4L19 7"></path>
                                    </svg>
                                </div>
                                <span class="leading-relaxed">Implement learner-centered and flexible pedagogies through MILES and other innovative learning systems;</span>
                            </li>
                        {% endif %}
                    </ul>

                </div>
            </div>
        </div>
    </div>
</section>

{% endblock %}