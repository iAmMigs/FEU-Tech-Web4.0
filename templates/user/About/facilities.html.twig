{% extends 'base.html.twig' %}

{% block title %}Facilities Office | FEU Institute of Technology{% endblock %}

{% block body %}

<section class="relative min-h-[60vh] flex items-end overflow-hidden bg-slate-800">

    <div class="absolute inset-0">
        <img src="/images/FEU_TECH.jpg"
             alt="FEU Tech Facilities"
             class="w-full h-full object-cover">

        <div class="absolute inset-0 bg-slate-950/70"></div>

        <div class="absolute inset-0 bg-gradient-to-r from-[#003b25]/90 via-[#003b25]/60 to-transparent"></div>

        <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-[#008348] via-[#febe10] to-[#008348]"></div>
    </div>

    <div class="absolute top-20 right-[-120px] w-[400px] h-[400px] bg-[#febe10]/10 blur-3xl rounded-full"></div>
    <div class="absolute bottom-[-150px] left-[-100px] w-[350px] h-[350px] bg-[#008348]/20 blur-3xl rounded-full"></div>

    <div class="relative z-10 max-w-7xl mx-auto mt-10 px-6 lg:px-8 pt-10 pb-20 w-full">

        <div class="max-w-3xl">

            <span class="inline-flex items-center px-5 py-2 rounded-full bg-white/10 backdrop-blur-md border border-white/10 text-feu-yellow text-sm font-bold tracking-[0.25em] uppercase mb-7">
                {{ page.heroTag }}
            </span>

            <h1 class="text-5xl md:text-6xl lg:text-7xl font-black text-white leading-[0.95] tracking-tight">
                {{ page.heroTitleWhite }}
                <span class="text-feu-yellow block mt-2">
                    {{ page.heroTitleYellow }}
                </span>
            </h1>

            <p class="mt-8 text-lg md:text-xl text-slate-200 leading-relaxed max-w-2xl">
                {{ page.heroDescription }}
            </p>
        </div>

    </div>

</section>


<section class="max-w-7xl mx-auto px-6 lg:px-8 mt-10 mb-24 relative z-40">
    <div class="flex flex-col items-center justify-center">
        
        <div class="flex flex-col items-center mb-10 text-center">
            <span class="text-[#008348] text-xs font-bold tracking-[0.3em] uppercase bg-[#008348]/10 px-4 py-1.5 rounded-full mb-3">
                {{ page.tourBadge }}
            </span>
        </div>

        <div class="relative w-full md:w-[85%] lg:w-[75%] group">
            
            <div class="absolute -inset-1.5 bg-gradient-to-r from-[#008348] via-[#febe10] to-[#008348] rounded-[2.3rem] opacity-30 blur-2xl group-hover:opacity-45 transition duration-700 ease-in-out"></div>
            <div class="absolute -inset-px bg-gradient-to-r from-[#008348]/40 via-[#febe10]/40 to-[#008348]/40 rounded-[2.1rem] z-0"></div>

            <div class="relative z-10 overflow-hidden rounded-[2rem] bg-slate-950 aspect-video shadow-[0_30px_100px_rgba(0,59,37,0.25)] border border-white/10">
                
                <div class="absolute top-0 inset-x-0 h-12 bg-gradient-to-b from-black/80 to-transparent z-20 px-6 flex items-center justify-between opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none">
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-[#008348]"></span>
                        <span class="w-2.5 h-2.5 rounded-full bg-[#febe10]"></span>
                        <span class="w-2.5 h-2.5 rounded-full bg-slate-600"></span>
                        <span class="text-[11px] text-feu-green font-medium tracking-wide ml-2 uppercase">FEU Institute of Technology</span>
                    </div>
                    <span class="text-[10px] text-white/60 bg-white/10 px-2 py-0.5 rounded backdrop-blur-sm tracking-widest font-mono">1080P HD</span>
                </div>

                <video
                    class="w-full h-full object-cover transition duration-500"
                    controls
                    autoplay
                    loop
                    muted
                    playsinline
                    preload="metadata"
                    poster="/images/yt.png">

                    <source src="/images/facility/{{ page.videoPath }}" type="video/mp4">
                </video>

            </div>
            
            <div class="absolute -bottom-6 inset-x-12 h-6 bg-[#003b25]/10 rounded-full blur-xl z-0"></div>
        </div>
    </div>
</section>


<section id="facilities-section" class="relative z-30 mt-10 overflow-visible bg-[#f8fafc] py-14">

    <div class="absolute top-0 left-0 w-[450px] h-[450px] bg-feu-green/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 right-0 w-[450px] h-[450px] bg-feu-yellow/10 rounded-full blur-3xl"></div>

    <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-[340px_1fr] gap-8">

            <div class="space-y-4">
                {% for item in tabs %}
                    {# Alternates styling automatically based on loop counters instead of database fields #}
                    {% set colorClass = (loop.index % 2 == 0) ? 'yellow' : 'emerald' %}
                    <button onclick="showContent({{ loop.index0 }})"
                            class="facility-btn {{ loop.first ? 'active' : '' }}">

                        <div class="flex items-center gap-4">
                            <div class="facility-icon {{ colorClass }}">
                                {{ "%02d"|format(loop.index) }}
                            </div>

                            <div class="text-left">
                                <h2 class="font-bold text-slate-800 text-sm">
                                    {{ item.navTitle }}
                                </h2>
                                <p class="text-xs text-slate-500 mt-1">
                                    {{ item.navSubtitle }}
                                </p>
                            </div>
                        </div>

                    </button>
                {% endfor %}
            </div>

            <div id="viewer"
                 class="relative overflow-hidden rounded-[2rem] bg-white border border-slate-200 shadow-[0_25px_80px_rgba(15,23,42,0.08)]">
            </div>

        </div>
    </div>

</section>


<style>
.sync-marquee-wrapper { gap: 2rem; }
.marquee-content {
    flex-shrink: 0; display: flex; justify-content: space-around; min-width: 100%; gap: 2rem;
    animation: scroll-marquee 25s linear infinite;
}
@keyframes scroll-marquee { 0% { transform: translateX(0%); } 100% { transform: translateX(-100%); } }
.facility-btn { width: 100%; padding: 1rem; border-radius: 1.4rem; background: white; border: 1px solid #e2e8f0; transition: all .3s ease; box-shadow: 0 4px 20px rgba(15,23,42,.03); }
.facility-btn:hover { transform: translateY(-4px); border-color: rgba(0,131,72,.2); box-shadow: 0 16px 35px rgba(15,23,42,.08); }
.facility-btn.active { background: #003b25; border-color: #003b25; }
.facility-btn.active h2, .facility-btn.active p { color: white; }
.facility-icon { width: 44px; height: 44px; min-width: 44px; border-radius: .9rem; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: .8rem; transition: .3s; }
.facility-icon.emerald { background: #ecfdf5; color: #008348; }
.facility-icon.yellow { background: #fef9c3; color: #ca8a04; }
.facility-btn.active .facility-icon { background: rgba(255,255,255,.1); color: #febe10; }
.facility-stat-card { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 1.25rem; padding: 1.2rem; }
.facility-stat-card .stat-title { font-size: 2rem; font-weight: 900; line-height: 1; }
.facility-stat-card p { margin-top: .55rem; font-size: .82rem; color: #64748b; line-height: 1.5; }
.facility-main-image { transition: opacity .35s ease; }
.gallery-thumb { width: 80px; height: 80px; overflow: hidden; border-radius: 1rem; border: 3px solid rgba(255,255,255,.7); background: white; cursor: pointer; transition: all .3s ease; box-shadow: 0 10px 30px rgba(0,0,0,.25); }
.gallery-thumb:hover { transform: translateY(-5px) scale(1.05); border-color: #febe10; }
.gallery-thumb img { width: 100%; height: 100%; object-fit: cover; }
</style>


<script>
// Dynamic Array mapping data objects fed directly from backend collections
const data = [
    {% for item in tabs %}
    {
        badge: {{ item.contentBadge|json_encode|raw }},
        title: {{ item.contentTitle|json_encode|raw }},
        images: [
            "/images/facility/{{ item.imgOne }}",
            "/images/facility/{{ item.imgTwo }}",
            "/images/facility/{{ item.imgThree }}"
        ],
        desc: `
            {% for paragraph in item.descriptionMarkdown|split('\r\n') %}
                {% if paragraph|trim is not empty %}
                    <p class="mb-4">{{ paragraph|raw }}</p>
                {% endif %}
            {% endfor %}
        `,
        stats: `
            <div class="facility-stat-card">
                <div class="stat-title text-feu-green">{{ item.statOneTitle|raw }}</div>
                <p>{{ item.statOneDesc|raw }}</p>
            </div>
            <div class="facility-stat-card">
                <div class="stat-title text-feu-yellow">{{ item.statTwoTitle|raw }}</div>
                <p>{{ item.statTwoDesc|raw }}</p>
            </div>
            <div class="facility-stat-card">
                <div class="stat-title text-slate-800">{{ item.statThreeTitle|raw }}</div>
                <p>{{ item.statThreeDesc|raw }}</p>
            </div>
        `
    }{{ not loop.last ? ',' : '' }}
    {% endfor %}
];

function changeGalleryImage(src){
    const mainImage = document.getElementById("mainFacilityImage");
    mainImage.style.opacity = "0";
    setTimeout(() => {
        mainImage.src = src;
        mainImage.style.opacity = "1";
    }, 200);
}

function showContent(index){
    const viewer = document.getElementById("viewer");
    const buttons = document.querySelectorAll(".facility-btn");

    buttons.forEach(btn => btn.classList.remove("active"));
    buttons[index].classList.add("active");

    viewer.innerHTML = `
        <div class="relative overflow-hidden">
            <div class="relative h-[420px] overflow-hidden">
                <img 
                    id="mainFacilityImage"
                    src="${data[index].images[0]}"
                    class="w-full h-full object-cover facility-main-image">
                <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-900/40 to-transparent"></div>
                <div class="absolute bottom-16 left-0 p-8 lg:p-10">
                    <div class="inline-flex items-center px-4 py-2 rounded-full bg-white/10 backdrop-blur-md border border-white/10 text-white text-xs font-bold uppercase tracking-[0.2em] mb-5">
                        ${data[index].badge}
                    </div>
                    <h2 class="text-4xl lg:text-5xl font-black text-white max-w-3xl leading-tight">
                        ${data[index].title}
                    </h2>
                </div>
            </div>
            <div class="absolute bottom-6 right-6 flex gap-4 z-20">
                ${data[index].images.map((img) => `
                    <button 
                        onclick="changeGalleryImage('${img}')"
                        class="gallery-thumb">
                        <img src="${img}" class="w-full h-full object-cover">
                    </button>
                `).join('')}
            </div>
        </div>
        <div class="p-8 lg:p-10">
            <div class="grid grid-cols-1 lg:grid-cols-[1.2fr_.8fr] gap-10">
                <div>
                    <div class="space-y-4 text-slate-600 leading-loose text-[16px] lg:text-[17px] font-medium">
                        ${data[index].desc}
                    </div>
                </div>
                <div class="grid grid-cols-1 gap-4">
                    ${data[index].stats}
                </div>
            </div>
        </div>
    `;
}

// Render dynamic baseline collection on initial page load
document.addEventListener("DOMContentLoaded", () => {
    if(data.length > 0) {
        showContent(0);
    }
});
</script>

{% endblock %}