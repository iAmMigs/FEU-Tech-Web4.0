{% extends 'base.html.twig' %}

{% block body %}
<section id="top" class="relative w-full h-[25vh] min-h-[220px] flex items-end justify-center overflow-hidden bg-[#004026]">
    <div class="absolute inset-0 z-0">
        <img src="/images/history/1936.jpg" alt="Hero Background" class="w-full h-full object-cover opacity-30 mix-blend-overlay">
    </div>
    <div class="relative z-10 text-center px-5 max-w-4xl mx-auto pb-12">
        <h1 class="text-4xl md:text-6xl font-black text-white uppercase tracking-wider">
            History of <span class="text-[#EFA316]">FEU Tech</span>
        </h1>
        <div class="w-24 h-1 bg-[#EFA316] mx-auto mt-4"></div>
    </div>
</section>

<div class="bg-white min-h-screen py-16 px-4 md:px-12 lg:px-20 overflow-x-hidden">
    <div class="relative max-w-6xl mx-auto" id="timeline">
        
        <div class="absolute left-[131px] md:left-[163px] top-4 bottom-0 w-[6px] bg-[#004026]/20 rounded z-0"></div>
        <div id="timeline-line" class="absolute left-[131px] md:left-[163px] top-4 w-[6px] h-0 transition-[height] duration-300 z-[5] rounded"></div>

        <div class="space-y-16">
            {% for item in timeline %}
                {# Automatically alternate themes if desired, or stick to item.theme. Using a fallback just in case. #}
                {% set theme = loop.index is odd ? 'gold' : 'emerald' %}
                
                <div class="relative z-10 flex items-center timeline-item opacity-0 transform translate-y-8 transition-all duration-700 ease-out min-h-[100px]" data-index="{{ loop.index0 }}" data-theme="{{ theme }}">
                    
                    <div class="w-28 h-28 flex items-center justify-center shrink-0 pl-2">
                        <div class="border-2 p-1.5 rounded-xl w-full h-full flex items-center justify-center bg-white {{ theme == 'gold' ? 'border-amber-500 text-amber-500' : 'border-emerald-800 text-emerald-800' }}">
                            {% if item.iconImage %}
                                <img src="{{ asset('images/history/' ~ item.iconImage) }}" alt="{{ item.year }} icon" class="w-full h-full object-cover rounded-lg">
                            {% endif %}
                        </div>
                    </div>

                    <div class="absolute left-[118px] md:left-[150px] flex items-center z-30 group-node">
                        <div class="w-7 h-7 rounded-full bg-white border-4 {{ theme == 'gold' ? 'border-[#EFA316]' : 'border-[#004026]' }} flex items-center justify-center shadow-sm relative shrink-0 z-20">
                            <div class="timeline-dot w-2 h-2 rounded-full {{ theme == 'gold' ? 'bg-[#EFA316]' : 'bg-[#004026]' }} transition-all duration-300"></div>
                        </div>
                        
                        <img src="/images/readingtamtam2.gif"
                            class="timeline-gif absolute left-[-10px] w-12 h-12 object-contain opacity-0 scale-75 transition-all duration-300 z-40 pointer-events-none rounded-full border-2 {{ theme == 'gold' ? 'border-[#EFA316]' : 'border-[#004026]' }} bg-white max-w-none">

                        <div class="relative -ml-1 h-14 flex items-center pl-6 pr-8 font-black text-white text-2xl font-sans tracking-wide shadow-md rounded-r-lg {{ theme == 'gold' ? 'bg-[#EFA316]' : 'bg-[#004026]' }} [clip-path:polygon(0%_0%,_85%_0%,_100%_50%,_85%_100%,_0%_100%)] min-w-[110px] md:min-w-[130px] z-10">
                            {{ item.year }}
                        </div>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 w-full pl-52 md:pl-64 items-center py-4">
                        <div class="lg:col-span-4">
                            <h3 class="text-lg md:text-xl font-bold font-sans tracking-tight {{ theme == 'gold' ? 'text-[#EFA316]' : 'text-[#004026]' }}">
                                {{ item.title }}
                            </h3>
                        </div>
                        
                        <div class="lg:col-span-5">
                            <p class="text-xs md:text-sm text-gray-600 leading-relaxed font-medium">
                                {{ item.content }}
                            </p>
                        </div>
                        
                        <div class="lg:col-span-3 flex justify-start lg:justify-end">
                            {% if item.tag is not empty %}
                                <div class="px-4 py-3 border-2 {{ theme == 'gold' ? 'border-[#EFA316]' : 'border-[#004026]' }} bg-white rounded-xl text-center w-full max-w-[220px] shadow-sm flex items-center gap-3 justify-center">
                                    <span class="text-[10px] font-black text-gray-700 uppercase tracking-wider text-left leading-tight block">
                                        {{ item.tag }}
                                    </span>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        <div class="mt-24 timeline-item opacity-0 transform translate-y-8 transition-all duration-700 ease-out -mx-4 md:-mx-12 lg:-mx-20 relative z-10" data-index="{{ timeline|length }}" data-theme="gold">
            
            <div class="absolute inset-y-0 left-0 right-0 pointer-events-none z-30">
                <div class="absolute left-[147px] md:left-[211px] lg:left-[243px] top-0 h-48 w-[6px] bg-gradient-to-b from-white/20 via-white/20 to-transparent"></div>
                <div id="timeline-line-end" class="absolute left-[147px] md:left-[211px] lg:left-[243px] top-0 w-[6px] bg-gradient-to-b from-white via-white to-transparent h-0 transition-all duration-300"></div>

                <div class="absolute left-[134px] md:left-[200px] lg:left-[232px] top-32 flex items-center z-30">
                    <div class="w-8 h-8 rounded-full bg-white border-4 border-[#EFA316] flex items-center justify-center shadow-md relative shrink-0 z-20">
                        <div class="timeline-dot-end w-2 h-2 rounded-full bg-[#EFA316] transition-all duration-300"></div>
                    </div>
                    <img src="/images/readingtamtam2.gif" class="timeline-gif-end absolute -left-[4px] w-10 h-10 object-contain opacity-0 scale-75 transition-all duration-300 z-40 pointer-events-none rounded-full border-2 border-[#EFA316] bg-white max-w-none">
                </div>
            </div>

            <div class="w-full bg-[#003820] text-white relative flex flex-col min-h-[480px]">
                
                <div class="absolute left-0 -top-16 bottom-0 w-full lg:w-[23%] z-10 pointer-events-none">
                    <img src="/images/history/FEUFooter.png" alt="FEU Tech Building" class="w-full h-full object-cover">
                    <div class="absolute inset-0 bg-gradient-to-r from-transparent to-[#003820]"></div>
                </div>

                <div class="absolute left-4 md:left-[36px] lg:left-[48px] top-1/2 -translate-y-1/2 z-20 hidden sm:block">
                    {% if footer.logoImage %}
                        <img src="{{ asset('images/' ~ footer.logoImage) }}" class="w-40 h-40 object-contain" alt="Logo">
                    {% else %}
                        <img src="/images/Tech_Logo.png" class="w-40 h-40 object-contain" alt="Logo Fallback">
                    {% endif %}
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center pl-48 pr-6 md:pl-64 md:pr-16 lg:pl-80 lg:pr-24 pt-16 pb-20 relative z-20 my-auto">
                    <div class="lg:col-span-6 space-y-4 text-left">
                        <span class="text-6xl md:text-7xl font-black tracking-tighter block text-white font-sans">{{ footer.year }}</span>
                        <h3 class="text-2xl md:text-3xl font-extrabold text-[#EFA316] uppercase tracking-wide leading-tight font-sans">{{ footer.title }}</h3>
                        <p class="text-xs md:text-sm text-gray-200 font-medium leading-relaxed max-w-xl">
                            {{ footer.content }}
                        </p>
                    </div>
                    <div class="lg:col-span-6 flex justify-center lg:justify-end w-full">
                        <div class="border-[3px] border-[#EFA316] p-6 md:p-8 rounded-2xl text-center max-w-md w-full bg-[#002b18]/90 shadow-2xl relative font-sans">
                            <div class="flex items-center justify-center gap-4 mb-4">
                                <div>
                                    <img src="/images/history/footer.png" class="w-16 h-16">
                                </div>
                                <p class="text-xs uppercase tracking-widest text-white font-bold leading-tight text-left">
                                    {{ footer.subtitle }}
                                </p>
                            </div>

                            <h2 class="text-5xl font-bold text-[#EFA316] mb-4 font-['Poppins'] tracking-[0.3em] scale-y-[2] origin-center inline-block">
                                {{ footer.badgeText }}
                            </h2>
                            
                            <div class="border-2 border-[#EFA316] py-2 px-2 inline-block w-full">
                                <span class="text-[15px] font-bold text-[#EFA316] block uppercase font-['Poppins'] whitespace-nowrap tracking-[0.5em]">
                                    {{ footer.footerTagline }}
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-auto w-full bg-[#002615] py-5 px-6 border-t border-white/10 text-center relative z-20">
                    <div class="flex flex-wrap justify-center items-center gap-4 md:gap-10 text-[11px] tracking-widest text-gray-300 uppercase">
                        <span class="flex items-center gap-2"><svg class="w-4 h-4 text-[#EFA316]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path></svg> Engineering Roots</span>
                        <span class="text-[#EFA316] font-bold select-none">•</span>
                        <span class="flex items-center gap-2"><svg class="w-4 h-4 text-[#EFA316]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9h18"></path></svg> Technology Driven</span>
                        <span class="text-[#EFA316] font-bold select-none">•</span>
                        <span class="flex items-center gap-2"><svg class="w-4 h-4 text-[#EFA316]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg> Future Ready</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    (() => {
        const initTimeline = () => {
            const items = document.querySelectorAll('.timeline-item');
            const line = document.getElementById('timeline-line');
            const lineEnd = document.getElementById('timeline-line-end');
            const timeline = document.getElementById('timeline');
            
            if (!timeline) return;
            
            const lastIndex = items.length - 1;

            const revealObserver = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.remove('opacity-0', 'translate-y-8');
                        entry.target.classList.add('opacity-100', 'translate-y-0');
                    }
                });
            }, { threshold: 0.05 });

            items.forEach(item => revealObserver.observe(item));

            const updateTrackProgress = () => {
                if (!items.length || !line) return;
                let activeIndex = -1;
                const viewportMiddle = window.innerHeight * 0.55;

                items.forEach((item, index) => {
                    const rect = item.getBoundingClientRect();
                    if (rect.top < viewportMiddle) {
                        activeIndex = index;
                    }
                });

                const timelineTop = timeline.getBoundingClientRect().top + window.scrollY;
                let targetHeight = 0;

                if (activeIndex < 0) {
                    line.style.height = '0px';
                    if(lineEnd) lineEnd.style.height = '0px';
                } else {
                    const currentItem = items[activeIndex];
                    
                    if (activeIndex === lastIndex) {
                        const endContainerTop = currentItem.getBoundingClientRect().top + window.scrollY;
                        targetHeight = (endContainerTop - timelineTop);
                        line.style.height = targetHeight + 'px';
                        if(lineEnd) lineEnd.style.height = '180px';
                    } else {
                        const marker = currentItem.querySelector('.rounded-full');
                        const markerCenter = marker.getBoundingClientRect().top + window.scrollY + (marker.offsetHeight / 2);
                        targetHeight = (markerCenter - timelineTop);
                        line.style.height = targetHeight + 'px';
                        if(lineEnd) lineEnd.style.height = '0px';
                    }
                }

                if (targetHeight > 0) {
                    let colorStops = [];
                    items.forEach((item, index) => {
                        const theme = item.dataset.theme;
                        const colorHex = (theme === 'gold') ? '#EFA316' : '#004026';
                        
                        let nodePos = 0;
                        if (index === lastIndex) {
                            nodePos = item.getBoundingClientRect().top + window.scrollY - timelineTop;
                        } else {
                            const marker = item.querySelector('.rounded-full');
                            if (marker) {
                                nodePos = marker.getBoundingClientRect().top + window.scrollY + (marker.offsetHeight / 2) - timelineTop;
                            }
                        }

                        if (nodePos <= targetHeight) {
                            let percentage = (nodePos / targetHeight) * 100;
                            colorStops.push(`${colorHex} ${percentage.toFixed(1)}%`);
                        } else {
                            let percentage = 100;
                            colorStops.push(`${colorHex} ${percentage}%`);
                        }
                    });

                    if (colorStops.length === 1) {
                        const activeTheme = items[activeIndex].dataset.theme;
                        const primaryColor = activeTheme === 'gold' ? '#EFA316' : '#004026';
                        line.style.backgroundImage = `linear-gradient(to bottom, ${primaryColor}, ${primaryColor})`;
                    } else {
                        line.style.backgroundImage = `linear-gradient(to bottom, ${colorStops.join(', ')})`;
                    }
                } else {
                    line.style.backgroundImage = 'none';
                }

                items.forEach((item, index) => {
                    if (index === lastIndex) {
                        const endDot = item.querySelector('.timeline-dot-end');
                        const endGif = item.querySelector('.timeline-gif-end');
                        if (endDot && endGif) {
                            if (activeIndex === lastIndex) {
                                endDot.classList.add('opacity-0', 'scale-0');
                                endGif.classList.remove('opacity-0', 'scale-75');
                                endGif.classList.add('opacity-100', 'scale-100');
                            } else {
                                endDot.classList.remove('opacity-0', 'scale-0');
                                endGif.classList.remove('opacity-100', 'scale-100');
                                endGif.classList.add('opacity-0', 'scale-75');
                            }
                        }
                        return;
                    }

                    const dot = item.querySelector('.timeline-dot');
                    const gif = item.querySelector('.timeline-gif');

                    if (gif && dot) {
                        if (index === activeIndex) {
                            dot.classList.add('opacity-0', 'scale-0');
                            gif.classList.remove('opacity-0', 'scale-75');
                            gif.classList.add('opacity-100', 'scale-100'); 
                        } else {
                            dot.classList.remove('opacity-0', 'scale-0');
                            gif.classList.remove('opacity-100', 'scale-100');
                            gif.classList.add('opacity-0', 'scale-75');
                        }
                    }
                });
            };

            window.removeEventListener('scroll', updateTrackProgress);
            window.removeEventListener('resize', updateTrackProgress);

            window.addEventListener('scroll', updateTrackProgress);
            window.addEventListener('resize', updateTrackProgress);
            updateTrackProgress();
        };

        initTimeline();
        document.addEventListener("DOMContentLoaded", initTimeline);
        document.addEventListener("turbo:load", initTimeline);
    })();
</script>
{% endblock %}