                                </p>

                                <p class="text-slate-600">
                                    The BS Computer Engineering program, major in Network Administration and Cybersecurity prepares students to perform a wide-array of tasks in the day-to-day operation of networks and cybersecurity. This program will shape them into highly effective future network administrators and cybersecurity experts who are critical thinkers, problem solvers, and innovators.
                                </p>
                            </div>

                        </div>
{% endblock %}

{% block faculty_default %}
    {% set faculty = [] %}
    {% for item in faculty %}
        <div class="faculty-card bg-white rounded-[2.5rem] p-8 shadow-2xl border border-slate-100 flex flex-col md:flex-row gap-8 items-start hover:shadow-feu-green/10 transition duration-300">
            <div>
                <h3 class="text-2xl font-black text-feu-green mb-2">
                    {{ item.name }}
                </h3>

                <p class="text-feu-yellow font-black uppercase text-xs tracking-widest mb-5">
                    {{ item.role }}
                </p>

                <div class="mb-4">
                    <p class="font-black text-feu-green text-sm uppercase mb-1">Degree</p>
                    <p class="text-slate-600 whitespace-pre-line">{{ item["information-1"] }}</p>
                </div>

                <div class="mb-4">
                    <p class="font-black text-feu-green text-sm uppercase mb-1">Specialization</p>
                    <p class="text-slate-600">{{ item.specialization }}</p>
                </div>

                <div class="mb-4">
                    <p class="font-black text-feu-green text-sm uppercase mb-1">Professional Certification</p>
                    <p class="text-slate-600">{{ item["information-2"] }}</p>
                </div>

                {% if item.affiliation is defined and item.affiliation %}
                <div>
                    <p class="font-black text-feu-green text-sm uppercase mb-1">Affiliation</p>
                    <p class="text-slate-600 whitespace-pre-line">{{ item.affiliation }}</p>
                </div>
                {% endif %}
            </div>
        </div>
    {% endfor %}
{% endblock %}
