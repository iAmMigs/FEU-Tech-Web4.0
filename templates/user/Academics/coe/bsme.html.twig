{% extends 'user/Academics/program_detail.html.twig' %}

{% block title %}Bachelor of Science in Mechanical Engineering{% endblock %}
{% block default_hero_image %}images/Academics/bsme.png{% endblock %}

{% block overview_default %}
<p class="text-slate-600 leading-relaxed text-lg mb-6">
                            The field of mechanical engineering covers two broad areas: the thermal system and the mechanical system.
                        </p>

                        <p class="text-slate-600 leading-relaxed text-lg mb-6">
                            The traditional courses in mechanical engineering that include power plant engineering, industrial plant engineering and machine design are supplemented by new and emerging fields such as renewable energy systems, mechatronics, control system and computer applications.
                        </p>

                        <p class="text-slate-600 leading-relaxed text-lg mb-6">
                            The Bachelor of Science in Mechanical Engineering program has the following distinctive features: elective courses in the new and emerging technologies; industry immersion or on-the-job training; research project; and a culminating design project.
                        </p>

                        <p class="text-slate-600 leading-relaxed text-lg">
                            The program also offers new courses such as technopreneurship, design thinking and bio-engineering.
                        </p>

                    </div>

                    <div class="bg-white rounded-[3rem] mt-12 p-10 shadow-2xl border border-slate-100 glow-hover">

                        <div class="flex items-center gap-5 mb-8">

                            <div>

                                <p class="uppercase tracking-[0.3em] text-feu-yellow font-black text-xs mb-2">
                                    Educational Philosophy
                                </p>

                                <h2 class="text-4xl font-black text-feu-green uppercase">
                                    FEU Tech Philosophy
                                </h2>

                            </div>

                        </div>

                        <p class="text-slate-600 leading-relaxed text-lg">
                            FEU Tech's educational philosophy is rooted in transformative learning, emphasizing innovation, relevance, and social responsibility. We aim to cultivate an ecosystem of learning that shapes the next generation of leaders and innovators, driving positive change both locally and globally.
                        </p>
{% endblock %}

{% block objectives_default %}
<p class="text-slate-600 text-lg mb-8">
                            By the time of graduation, the students should have/ be able to:
                        </p>

                        <div class="grid md:grid-cols-2 gap-6">

                            <div class="bg-slate-50 rounded-[2rem] p-6 border border-slate-100">
                                <h3 class="font-black text-feu-green mb-4 uppercase">
                                    Professional Practice
                                </h3>

                                <p class="text-slate-600">
                                    Engaged in the practice of Mechanical Engineering or technopreneurship and innovation.
                                </p>
                            </div>

                            <div class="bg-slate-50 rounded-[2rem] p-6 border border-slate-100">
                                <h3 class="font-black text-feu-green mb-4 uppercase">
                                    Leadership
                                </h3>

                                <p class="text-slate-600">
                                    Assumed significant roles with key responsibilities in their workplace.
                                </p>
                            </div>

                            <div class="bg-slate-50 rounded-[2rem] p-6 border border-slate-100">
                                <h3 class="font-black text-feu-green mb-4 uppercase">
                                    Organizations
                                </h3>

                                <p class="text-slate-600">
                                    Involved in professional, socio-civic, government, or non-government organizations.
                                </p>
                            </div>

                            <div class="bg-slate-50 rounded-[2rem] p-6 border border-slate-100">
                                <h3 class="font-black text-feu-green mb-4 uppercase">
                                    Continuous Development
                                </h3>

                                <p class="text-slate-600">
                                    Demonstrated continuous professional development through certifications, attendance to training, seminars, and conferences and/or pursuit of graduate studies in engineering or related fields.
                                </p>
                            </div>

                        </div>
{% endblock %}

{% block specializations_default %}
<div class="grid md:grid-cols-2 gap-6">

                            <div class="bg-slate-50 rounded-[2rem] p-6 border border-slate-100">
                                <h3 class="font-black text-feu-green mb-4 uppercase">
                                    Mechatronics
                                </h3>
                            
                                <p class="text-slate-600">
                                    Mechatronics focuses on a multidisciplinary field that refers to the skill sets and knowledge needed in the contemporary, advanced automated manufacturing industry. It is at the intersection of mechanics, electronics, and computing.
                                </p>
                            </div>

                            <div class="bg-slate-50 rounded-[2rem] p-6 border border-slate-100">
                                <h3 class="font-black text-feu-green mb-4 uppercase">
                                    Materials Science and Engineering
                                </h3>

                                <p class="text-slate-600">
                                    Materials Science and Engineering (MSE) focuses on the combination of engineering, physics, and chemistry principles to solve real-world problems including those that are associated with nanotechnology, biotechnology, information technology, energy, manufacturing and other major engineering disciplines.
                                </p>
<div class="grid md:grid-cols-2 gap-6">

                            <div class="bg-slate-50 rounded-[2rem] p-6 border border-slate-100">
                                <h3 class="font-black text-feu-green mb-4 uppercase">
                                    Mechatronics
                                </h3>
                            
                                <p class="text-slate-600">
                                    Mechatronics focuses on a multidisciplinary field that refers to the skill sets and knowledge needed in the contemporary, advanced automated manufacturing industry. It is at the intersection of mechanics, electronics, and computing.
                                </p>
                            </div>

                            <div class="bg-slate-50 rounded-[2rem] p-6 border border-slate-100">
                                <h3 class="font-black text-feu-green mb-4 uppercase">
                                    Materials Science and Engineering
                                </h3>

                                <p class="text-slate-600">
                                    Materials Science and Engineering (MSE) focuses on the combination of engineering, physics, and chemistry principles to solve real-world problems including those that are associated with nanotechnology, biotechnology, information technology, energy, manufacturing and other major engineering disciplines.
                                </p>
                            </div>

                        </div>
{% endblock %}

{% block faculty_default %}
    {% set faculty = [] %}
    {% for item in faculty %}
        <div class="faculty-card bg-white rounded-[2.5rem] p-8 shadow-2xl border border-slate-100 flex flex-col md:flex-row gap-8 items-start hover:shadow-feu-green/10 transition duration-300">
            <div>
                <h3 class="text-2xl font-black text-feu-green mb-2">
                    {{ item.name }}
                </h3>

                <p class="text-feu-yellow font-black uppercase text-xs tracking-widest mb-5">
                    {{ item.role }}
                </p>

                <div class="mb-4">
                    <p class="font-black text-feu-green text-sm uppercase mb-1">Education</p>
                    <p class="text-slate-600 whitespace-pre-line">{{ item.education }}</p>
                </div>

                <div class="mb-4">
                    <p class="font-black text-feu-green text-sm uppercase mb-1">Research Area</p>
                    <p class="text-slate-600">{{ item.specialization }}</p>
                </div>

                <div class="mb-4">
                    <p class="font-black text-feu-green text-sm uppercase mb-1">Credentials</p>
                    <p class="text-slate-600">{{ item.credentials }}</p>
                </div>

                {% if item.affiliation is defined and item.affiliation %}
                <div>
                    <p class="font-black text-feu-green text-sm uppercase mb-1">Affiliation</p>
                    <p class="text-slate-600 whitespace-pre-line">{{ item.affiliation }}</p>
                </div>
                {% endif %}
            </div>
        </div>
    {% endfor %}

    <!-- PART TIME -->
    <div class="mb-10 mt-16">
        <h2 class="text-4xl font-black text-feu-green uppercase">
            Part-Time Faculty Members
        </h2>
    </div>

    <div class="grid md:grid-cols-2 xl:grid-cols-2 gap-8">
        {% set parttimeFaculty = [
            {
                name: 'Khansun T. Baravio',
                role: 'Part-Time Faculty',
                education: 'Bachelor of Science in Mechanical Engineering - FEU Institute of Technology',
                specialization: 'Smart Systems and Software Development',
                credentials: 'Registered Mechanical Engineer'
            },
            {
                name: 'Manuel C. Belino',
                role: 'Part-Time Faculty',
                education: "PhD in Engineering Education - De La Salle University\nMaster of Engineering - De La Salle University\nBachelor of Science in Mechanical Engineering - Mapua University",
                specialization: 'HVAC, Indoor Outdoor Air Quality, Engineering Education',
                credentials: 'Registered Mechanical Engineer'
            }
        ] %}

        {% for item in parttimeFaculty %}
            <div class="faculty-card bg-white rounded-[2rem] p-8 shadow-xl border border-slate-100">
                <div class="w-20 h-20 rounded-full bg-feu-green flex items-center justify-center text-white text-2xl font-black mb-6 float-animation">
                    {{ item.name|split(' ')[0]|first }}
                </div>

                <h3 class="text-2xl font-black text-feu-green mb-2">
                    {{ item.name }}
                </h3>

                <p class="text-feu-yellow font-black uppercase text-xs tracking-widest mb-5">
                    {{ item.role }}
                </p>

                <div class="mb-4">
                    <p class="font-black text-feu-green text-sm uppercase mb-1">Education</p>
                    <p class="text-slate-600 whitespace-pre-line">{{ item.education }}</p>
                </div>

                <div class="mb-4">
                    <p class="font-black text-feu-green text-sm uppercase mb-1">Research Area</p>
                    <p class="text-slate-600">{{ item.specialization }}</p>
                </div>

                <div>
                    <p class="font-black text-feu-green text-sm uppercase mb-1">Credentials</p>
                    <p class="text-slate-600">{{ item.credentials }}</p>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}
