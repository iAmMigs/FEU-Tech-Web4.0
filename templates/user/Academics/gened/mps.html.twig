<style>

    html {
        scroll-behavior: smooth;
    }

    body {
        background:
            radial-gradient(circle at top left, rgba(0,131,72,0.08), transparent 25%),
            radial-gradient(circle at bottom right, rgba(254,190,16,0.10), transparent 25%),
            #f8fafc;
    }

    .scroll-section {
        scroll-margin-top: 120px;
    }

    .nav-link.active {
        background: #008348;
        color: white;
        transform: translateX(6px);
    }

    .glass-card {
        backdrop-filter: blur(14px);
        background: rgba(255,255,255,.72);
    }

    .faculty-card {
        transition:
            transform .35s ease,
            box-shadow .35s ease;
    }

    .faculty-card:hover {
        transform: translateY(-8px);

        box-shadow:
            0 20px 50px rgba(0,131,72,.18),
            0 10px 30px rgba(254,190,16,.12);
    }

    .float-animation {
        animation: floating 5s ease-in-out infinite;
    }

    @keyframes floating {

        0%,100% {
            transform: translateY(0px);
        }

        50% {
            transform: translateY(-14px);
        }
    }

    .glow-hover {
        transition:
            transform .35s ease,
            box-shadow .35s ease;
    }

    .glow-hover:hover {

        transform: translateY(-8px);

        box-shadow:
            0 20px 50px rgba(0,131,72,.18),
            0 10px 30px rgba(254,190,16,.12);
    }

</style>

