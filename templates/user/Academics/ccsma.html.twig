{% extends 'base.html.twig' %}

{% block title %}College of Computer Studies & Multimedia Arts | FEU Institute of Technology{% endblock %}

{% block body %}

<!-- HERO SECTION -->
<section class="relative min-h-[92vh] overflow-hidden bg-[#03140d] flex items-center">

    <!-- Background -->
    <div class="absolute inset-0">
        <img src="/images/offices/academic.png"
             alt="CCSMA Hero"
             class="w-full h-full object-cover opacity-20">

        <div class="absolute inset-0 bg-gradient-to-br from-[#02110b]/80 via-[#05261a]/60 to-[#03140d]/85"></div>
    </div>

    <!-- Grid Overlay -->
    <div class="absolute inset-0 opacity-[0.06]"
         style="background-image:
         linear-gradient(rgba(255,255,255,0.08) 1px, transparent 1px),
         linear-gradient(90deg, rgba(255,255,255,0.08) 1px, transparent 1px);
         background-size: 42px 42px;">
    </div>

    <!-- Glow -->
    <div class="absolute top-0 left-0 w-[500px] h-[500px] bg-[#008348]/25 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-[#febe10]/15 rounded-full blur-3xl"></div>

    <!-- Content -->
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 w-full">

        <div class="max-w-4xl">

            <span class="inline-flex items-center gap-2 px-5 py-2 rounded-full border border-[#febe10]/20 bg-[#008348]/20 text-[#febe10] text-sm font-semibold tracking-[0.2em] uppercase">

                <svg xmlns="http://www.w3.org/2000/svg"
                     fill="none"
                     viewBox="0 0 24 24"
                     stroke-width="1.8"
                     stroke="currentColor"
                     class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M9.813 15.904L9 18l-.813-2.096A4.5 4.5 0 005.904 13.5L3.75 12l2.154-1.5A4.5 4.5 0 008.187 8.096L9 6l.813 2.096A4.5 4.5 0 0012.096 10.5L14.25 12l-2.154 1.5a4.5 4.5 0 00-2.283 2.404z"/>
                </svg>

                Innovate • Create • Engineer
            </span>

            <h1 class="mt-8 text-5xl md:text-7xl font-black text-white uppercase leading-[0.95]">
                College of
                <span class="block text-transparent bg-clip-text bg-[#febe10]">
                    Computer Studies
                </span>
                & Multimedia Arts
            </h1>

            <p class="mt-8 text-lg md:text-2xl text-slate-300 max-w-3xl leading-relaxed">
                Empowering future innovators through advanced computing,
                multimedia arts, cybersecurity, fintech,
                and digital transformation.
            </p>

            <div class="mt-10 flex flex-col sm:flex-row gap-4">

                <a href="#programs"
                   class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-2xl bg-[#008348] hover:bg-[#006839] text-white font-bold transition-all duration-300 hover:scale-105 shadow-lg shadow-[#008348]/20">

                    Explore Programs

                    <svg xmlns="http://www.w3.org/2000/svg"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke-width="2"
                         stroke="currentColor"
                         class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
                    </svg>

                </a>

            </div>

        </div>

    </div>

</section>

<!-- STICKY NAV -->
<div class="sticky top-[80px] z-40 bg-[#03140d]/85 backdrop-blur-xl border-y border-white/5">

    <div class="max-w-7xl mx-auto px-6">

        <div class="flex overflow-x-auto gap-8 py-4 text-sm font-semibold uppercase tracking-wide text-slate-300 scrollbar-hide">

            <a href="#overview" class="hover:text-[#febe10] transition whitespace-nowrap">
                Overview
            </a>

            <a href="#programs" class="hover:text-[#febe10] transition whitespace-nowrap">
                Programs
            </a>

            <a href="#advantages" class="hover:text-[#febe10] transition whitespace-nowrap">
                Why CCSMA
            </a>

        </div>

    </div>

</div>

<!-- OVERVIEW -->
<section id="overview" class="py-28 bg-[#f8fafc] scroll-mt-32">

    <div class="max-w-7xl mx-auto px-6 lg:px-8">

        <div class="grid lg:grid-cols-2 gap-20 items-center">

            <!-- LEFT -->
            <div>

                <span class="text-[#008348] font-bold uppercase tracking-[0.2em] text-sm">
                    About CCSMA
                </span>

                <h2 class="mt-5 text-4xl md:text-5xl font-black text-slate-900 leading-tight">
                    Building Future-Ready
                    Technology Professionals
                </h2>

                <p class="mt-6 text-lg text-slate-600 leading-relaxed">
                    The College of Computer Studies & Multimedia Arts develops
                    globally competitive graduates equipped with technical expertise,
                    creativity, innovation, and industry-ready skills.
                </p>

                <p class="mt-6 text-lg text-slate-600 leading-relaxed">
                    Through advanced programs in computing, cybersecurity,
                    multimedia arts, digital marketing, and financial technology,
                    students gain transformative learning experiences designed
                    for the digital future.
                </p>

            </div>

            <!-- ENHANCED SIDE CARDS -->
            <div class="grid gap-6">

                <div class="bg-white border border-slate-200 rounded-3xl p-7 shadow-sm hover:shadow-xl transition duration-300">

                    <div class="flex items-center gap-5">

                        <div class="w-16 h-16 rounded-2xl bg-[#008348]/10 flex items-center justify-center">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 class="w-8 h-8 text-[#008348]"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke="currentColor"
                                 stroke-width="1.8">
                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M3 7.5l9-4.5 9 4.5m-18 0l9 4.5m-9-4.5v9l9 4.5m0-9l9-4.5m-9 4.5v9"/>
                            </svg>

                        </div>

                        <div>
                            <h3 class="text-4xl font-black text-[#008348]">6</h3>
                            <p class="text-slate-600 font-medium mt-1">
                                Degree Programs
                            </p>
                        </div>

                    </div>

                </div>

                <div class="bg-white border border-slate-200 rounded-3xl p-7 shadow-sm hover:shadow-xl transition duration-300">

                    <div class="flex items-center gap-5">

                        <div class="w-16 h-16 rounded-2xl bg-[#febe10]/15 flex items-center justify-center">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 class="w-8 h-8 text-[#febe10]"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke="currentColor"
                                 stroke-width="1.8">
                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M9.75 17L15 12l-5.25-5"/>
                            </svg>

                        </div>

                        <div>
                            <h3 class="text-4xl font-black text-[#febe10]">100%</h3>
                            <p class="text-slate-600 font-medium mt-1">
                                Industry-Focused
                            </p>
                        </div>

                    </div>

                </div>

                <div class="bg-white border border-slate-200 rounded-3xl p-7 shadow-sm hover:shadow-xl transition duration-300">

                    <div class="flex items-center gap-5">

                        <div class="w-16 h-16 rounded-2xl bg-[#008348]/10 flex items-center justify-center">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 class="w-8 h-8 text-[#008348]"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke="currentColor"
                                 stroke-width="1.8">
                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M4.5 19.5l15-15m0 0v11.25m0-11.25H8.25"/>
                            </svg>

                        </div>

                        <div>
                            <h3 class="text-4xl font-black text-[#008348]">AI</h3>
                            <p class="text-slate-600 font-medium mt-1">
                                Emerging Technologies
                            </p>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- PROGRAMS -->
<section id="programs" class="pt-16 pb-28 bg-white scroll-mt-6">

    <div class="max-w-7xl mx-auto px-6 lg:px-8">

        <div class="text-center mb-16">
            <h2 class="text-4xl md:text-5xl font-black text-slate-800">
                Programs
            </h2>
        </div>

        <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-8">

            <!-- BSCS -->
            <div class="group bg-white border border-slate-200 rounded-3xl p-8 shadow-sm hover:shadow-2xl transition duration-300 hover:-translate-y-2">
               
                <div class="flex items-start gap-5 mb-6">
                    <div class="w-16 h-16 rounded-2xl bg-[#008348]/10 flex items-center justify-center mb-5">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             class="w-8 h-8 text-[#008348]"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke="currentColor"
                             stroke-width="1.8">
                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M8 8h8v8H8V8z"/>
                        </svg>

                    </div>

                    <h3 class="text-xl font-black uppercase leading-snug">
                        <a href="{{ path('app_bscs') }}"
                        class="group/link inline-flex items-center gap-2 text-[#008348] hover:text-[#febe10] transition duration-300">

                            <span>
                                Bachelor of Science in Computer Science
                            </span>

                            <svg xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="2"
                                stroke="currentColor"
                                class="w-10 h-10 transition-transform duration-300 group-hover/link:translate-x-1">

                                <path stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
                            </svg>

                        </a>
                    </h3>

                </a>

                </div>

                <p class="text-slate-600 leading-relaxed">
                    Includes  the study of computing concepts and theories, algorithmic foundations, and new developments in computing. The program prepares students to design and create algorithmically complex software and develop new and effective algorithms for solving computing problems. Graduates of this program can expect a successful and rewarding career in specification design, coding, and software testing. It also focuses on software engineering, database, and large-scale software.
                </p>

            </div>


            <!-- BSIT -->
            <div class="group bg-white border border-slate-200 rounded-3xl p-8 shadow-sm hover:shadow-2xl transition duration-300 hover:-translate-y-2">

                 <div class="flex items-start gap-5 mb-6">

                    <div class="w-16 h-16 rounded-2xl bg-[#febe10]/15 flex items-center justify-center mb-5">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             class="w-8 h-8 text-[#febe10]"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke="currentColor"
                             stroke-width="1.8">
                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M5 12h14M5 6h14M5 18h14"/>
                        </svg>

                    </div>

                    <h3 class="text-xl font-black uppercase leading-snug">
                        <a href="{{ path('app_bsit') }}"
                        class="group/link inline-flex items-center gap-2 text-[#008348] hover:text-[#febe10] transition duration-300">

                            <span>
                                Bachelor of Science in Information Technology
                            </span>

                            <svg xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="2"
                                stroke="currentColor"
                                class="w-10 h-10 transition-transform duration-300 group-hover/link:translate-x-1">

                                <path stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
                            </svg>

                        </a>
                    </h3>

                </div>

                <p class="text-slate-600 leading-relaxed">
                    The study of the use of computers and computer software to plan, install, customize, operate, manage, administer, and maintain information technology infrastructure. The program also deals with the study of design, development, and implementation of solutions that integrate information technology into businesses and organizations. It aims to prepare students to be IT professionals, well-versed in IT infrastructure development and administration, and experts in systems design and development for implementation in an organization.
                </p>

            </div>

            <!-- MMA -->
            <div class="group bg-white border border-slate-200 rounded-3xl p-8 shadow-sm hover:shadow-2xl transition duration-300 hover:-translate-y-2">

                 <div class="flex items-start gap-5 mb-6">

                    <div class="w-16 h-16 rounded-2xl bg-[#008348]/10 flex items-center justify-center mb-5">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             class="w-8 h-8 text-[#008348]"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke="currentColor"
                             stroke-width="1.8">
                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M9 19l-2 2m0-2l2 2m6-14l2-2m0 2l-2-2"/>
                        </svg>

                    </div>

                    <h3 class="text-xl font-black uppercase leading-snug text-[#008348]">
                        <a href="{{ path('app_bma') }}"
                        class="group/link inline-flex items-center gap-2 text-[#008348] hover:text-[#febe10] transition duration-300">

                            <span>
                                 Bachelor of Multimedia Arts
                            </span>

                            <svg xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="2"
                                stroke="currentColor"
                                class="w-10 h-10 transition-transform duration-300 group-hover/link:translate-x-1">

                                <path stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
                            </svg>

                        </a>
                    </h3>

                </div>

                <p class="text-slate-600 leading-relaxed">
                    Aligns itself with the rapid convergence of media technologies and practices by developing conceptual, technical, aesthetic, and professional competencies for effective, critical, and innovative storytelling.
                </p>

            </div>

            <!-- CYBER -->
            <div class="group bg-white border border-slate-200 rounded-3xl p-8 shadow-sm hover:shadow-2xl transition duration-300 hover:-translate-y-2">

                 <div class="flex items-start gap-5 mb-6">

                    <div class="w-16 h-16 rounded-2xl bg-[#febe10]/15 flex items-center justify-center mb-5">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             class="w-8 h-8 text-[#febe10]"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke="currentColor"
                             stroke-width="1.8">
                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M12 3l7 4v5c0 5-3 9-7 9s-7-4-7-9V7l7-4z"/>
                        </svg>

                    </div>

                    <h3 class="text-xl font-black uppercase leading-snug text-[#008348]">
                        <a href="{{ path('app_bscst') }}"
                        class="group/link inline-flex items-center gap-2 text-[#008348] hover:text-[#febe10] transition duration-300">

                            <span>
                                 Bachelor of Science in Cybersecurity
                            </span>

                            <svg xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="2"
                                stroke="currentColor"
                                class="w-10 h-10 transition-transform duration-300 group-hover/link:translate-x-1">

                                <path stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
                            </svg>

                        </a>
                    </h3>


                </div>

                <p class="text-slate-600 leading-relaxed">
                   Designed to provide students with a comprehensive education in the principles and practices of cybersecurity, covering fundamental concepts of computer systems, networks, and software. As well as advanced topics in cybersecurity, including threat analysis, risk management, and incident response.
                </p>

            </div>

            <!-- DIGITAL MARKETING -->
            <div class="group bg-white border border-slate-200 rounded-3xl p-8 shadow-sm hover:shadow-2xl transition duration-300 hover:-translate-y-2">

                 <div class="flex items-start gap-5 mb-6">

                    <div class="w-16 h-16 rounded-2xl bg-[#008348]/10 flex items-center justify-center mb-5">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             class="w-8 h-8 text-[#008348]"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke="currentColor"
                             stroke-width="1.8">
                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M3 10.5l18-6v15l-18-6v-3z"/>
                        </svg>

                    </div>



                    <h3 class="text-xl font-black uppercase leading-snug text-[#008348]">
                        <a href="{{ path('app_bdmm') }}"
                        class="group/link inline-flex items-center gap-2 text-[#008348] hover:text-[#febe10] transition duration-300">

                            <span>
                                 Bachelor of Digital Marketing and Management
                            </span>

                            <svg xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="2"
                                stroke="currentColor"
                                class="w-10 h-10 transition-transform duration-300 group-hover/link:translate-x-1">

                                <path stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
                            </svg>

                        </a>
                    </h3>

                </div>

                <p class="text-slate-600 leading-relaxed">
                    Focuses on developing students’ skills in planning, designing, and executing digital marketing campaigns while ensuring adherence to ethical standards, data privacy, and sustainability.
                </p>

            </div>

            <!-- FINTECH -->
            <div class="group bg-white border border-slate-200 rounded-3xl p-8 shadow-sm hover:shadow-2xl transition duration-300 hover:-translate-y-2">

                 <div class="flex items-start gap-5 mb-6">

                    <div class="w-16 h-16 rounded-2xl bg-[#febe10]/15 flex items-center justify-center mb-5">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             class="w-8 h-8 text-[#febe10]"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke="currentColor"
                             stroke-width="1.8">
                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M12 8c-3 0-5 1-5 3s2 3 5 3 5 1 5 3-2 3-5 3"/>
                        </svg>

                    </div>

                     <h3 class="text-xl font-black uppercase leading-snug text-[#008348]">
                        <a href="{{ path('app_bsfintech') }}"
                        class="group/link inline-flex items-center gap-2 text-[#008348] hover:text-[#febe10] transition duration-300">

                            <span>
                                BS in Financial Technology Engineering Program
                            </span>

                            <svg xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="2"
                                stroke="currentColor"
                                class="w-10 h-10 transition-transform duration-300 group-hover/link:translate-x-1">

                                <path stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
                            </svg>

                        </a>
                    </h3>


                </div>

                <p class="text-slate-600 leading-relaxed">
                    Integrates finance, technology, and engineering principles to develop cutting-edge financial solutions. It covers blockchain, artificial intelligence (AI) in finance, cybersecurity, data analytics, and financial systems engineering, preparing students to create secure, efficient, and innovative financial products.
                </p>

            </div>

        </div>

    </div>

</section>

