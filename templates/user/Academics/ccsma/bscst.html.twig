{% extends 'base.html.twig' %}

{% block title %}Bachelor of Science in Cybersecurity{% endblock %}

{% block body %}

<!-- Predefined Color Variables Mapping for FEU: 
     Green: #008348 -> text-emerald-700 / bg-[#008348]
     Yellow: #FEBE10 -> text-amber-500 / bg-[#FEBE10]
-->
<style>
    html {
        scroll-behavior: smooth;
    }

    body {
        background-color: #ffffff;
        background-image: 
            radial-gradient(circle at 10% 20%, rgba(0, 131, 72, 0.06) 0%, transparent 40%),
            radial-gradient(circle at 90% 80%, rgba(254, 190, 16, 0.08) 0%, transparent 40%),
            linear-gradient(rgba(15, 23, 42, 0.015) 1px, transparent 1px),
            linear-gradient(90deg, rgba(15, 23, 42, 0.015) 1px, transparent 1px);
        background-size: 100% 100%, 100% 100%, 40px 40px, 40px 40px;
    }

    .scroll-section {
        scroll-margin-top: 120px;
    }

    .nav-link.active {
        background: #008348;
        color: white;
        transform: translateX(6px);
    }

    /* Floating Circle Keyframes */
    @keyframes cyberFloat {
        0%, 100% { transform: translateY(0) scale(1); }
        50% { transform: translateY(-20px) scale(1.05); }
    }

    @keyframes pulseGlow {
        0%, 100% { box-shadow: 0 10px 30px rgba(0, 131, 72, 0.15); }
        50% { box-shadow: 0 10px 35px rgba(0, 131, 72, 0.3); }
    }

    .animate-cyber-float-1 { animation: cyberFloat 8s infinite ease-in-out; }
    .animate-cyber-float-2 { animation: cyberFloat 12s infinite ease-in-out; animation-delay: 2s; }
    .animate-cyber-float-3 { animation: cyberFloat 10s infinite ease-in-out; animation-delay: 4s; }
    .pulse-glow-green { animation: pulseGlow 4s infinite ease-in-out; }

    /* Custom Glassmorphism for Light Mode */
    .cyber-glass-light {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(15, 23, 42, 0.06);
    }

        .glass-card {
        backdrop-filter: blur(12px);
        background: rgba(255,255,255);
    }
</style>

<!-- BACKGROUND ANIMATED OBJECTS -->
<div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
    <div class="absolute one top-20 right-10 w-72 h-72 rounded-full bg-[#FEBE10] opacity-[0.08] blur-3xl animate-cyber-float-1"></div>
    <div class="absolute two top-1/2 left-5 w-96 h-96 rounded-full bg-[#008348] opacity-[0.06] blur-3xl animate-cyber-float-2"></div>
    <div class="absolute three bottom-20 right-1/4 w-80 h-80 rounded-full bg-[#FEBE10] opacity-[0.05] blur-3xl animate-cyber-float-3"></div>
</div>

<!-- HERO SECTION -->
<section class="relative z-10 overflow-hidden border-b border-slate-100">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <div class="relative group rounded-[2.5rem] overflow-hidden shadow-xl shadow-slate-200/50">
            <img src="/images/Academics/bscst.png" class="w-full h-auto block transform group-hover:scale-[1.01] transition-transform duration-700 ease-out" alt="Cybersecurity Hero">
            <div class="absolute inset-0 bg-gradient-to-t from-white/40 via-transparent to-transparent opacity-80"></div>
        </div>
    </div>
</section>

<!-- MAIN CONTENT CONTAINER -->
<main class="relative py-12 z-10">

    <div class="max-w-7xl mx-auto px-6 lg:px-10">

        <div class="grid lg:grid-cols-[300px,1fr] gap-10">

            <!-- SIDEBAR -->
            <aside class="hidden lg:block sticky top-10 self-start">

                <div class="bg-white rounded-[2.5rem] shadow-xl border border-slate-100 p-8">

                    <div class="flex items-center gap-4 mb-8">
                        <img src="/images/Tamtam/Reading_Book_Tammy.png"
                             class="w-20 object-contain"
                             alt="TamTam">

                        <div>
                            <p class="text-xs uppercase tracking-[0.3em] text-[#008348] font-black">
                                FEU TECH
                            </p>

                            <h2 class="text-2xl font-black text-[#008348] leading-tight">
                                BSCST
                            </h2>
                        </div>
                    </div>

                    <nav class="space-y-3">
                        <a href="#overview"
