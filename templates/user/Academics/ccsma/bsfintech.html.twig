{% extends 'user/Academics/program_detail.html.twig' %}

{% block title %}BS in Financial Technology Engineering{% endblock %}
{% block default_hero_image %}images/Academics/bsfintech.png{% endblock %}

{% block overview_default %}
<p class="text-slate-600 leading-relaxed text-lg mb-6">
                            The Financial Technology Engineering (FinTech Engineering) program integrates finance, technology, and engineering principles to develop cutting-edge financial solutions.
                        </p>

                        <p class="text-slate-600 leading-relaxed text-lg mb-6">
                            It covers blockchain, artificial intelligence (AI) in finance, cybersecurity, data analytics, and financial systems engineering, preparing students to create secure, efficient, and innovative financial products.
                        </p>

                        <p class="text-slate-600 leading-relaxed text-lg">
                            The curriculum includes financial software development, algorithmic trading, digital payments, regulatory compliance, and risk management.
                        </p>
{% endblock %}

{% block outcomes_default %}
<ul class="space-y-5 text-slate-600 text-lg font-medium">

                            <li>
                                • Design and develop innovative financial solutions using emerging technologies.
                            </li>

                            <li>
                                • Implement AI and machine learning models for financial forecasting and risk assessment.
                            </li>

                            <li>
                                • Secure financial transactions through blockchain and encryption.
                            </li>

                            <li>
                                • Build and optimize financial software for banks, trading firms, and FinTech startups.
                            </li>

                            <li>
                                • Analyze and improve financial data systems using big data analytics.
                            </li>

                            <li>
                                • Apply financial regulations and compliance in the tech-driven economy.
                            </li>

                        </ul>
{% endblock %}

{% block careers_default %}
<div class="bg-feu-green rounded-[2rem] p-8">

                            <h3 class="text-2xl font-black text-feu-yellow mb-6 uppercase">
                                Career Paths
                            </h3>

                            <ul class="grid md:grid-cols-2 gap-x-4 gap-y-2 text-white font-medium">

                                <li>• FinTech Engineer</li>
                                <li>• Blockchain Developer</li>
                                <li>• Cybersecurity Analyst</li>
                                <li>• Financial Data Scientist</li>
                                <li>• AI / ML Engineer (FinTech)</li>
                                <li>• Algorithmic Trader</li>
                                <li>• Investment Analyst</li>
                                <li>• Software Developer for Banking & Finance</li>
                                <li>• Risk & Compliance Analyst</li>
                                <li>• Digital Banking Specialist</li>
                                <li>• Data Analyst</li>
                                <li>• Financial Risk Manager</li>
                                <li>• Compliance & Regulatory Officer</li>
                                <li>• Product Manager (FinTech Apps)</li>

                            </ul>

                        </div>
{% endblock %}
