<script>
const magazines = [
    {
        img: "/images/magazine/issue1.png",
        link: "https://drive.google.com/file/d/1Nvc5Qvx9kIQOijV6fzbx6O6VC1t5M4LD/view"
    },
    {
        img: "/images/magazine/issue3.png",
        link: "https://heyzine.com/flip-book/fd6d3a5475.html#page/1"
    },
    {
        img: "/images/magazine/issue2.png",
        link: "https://drive.google.com/file/d/1rpQ8TCiGqPfzIsufRCltl_Y39OavyN9T/view"
    },
    {
        img: "/images/magazine/issue5.png",
        link: "https://heyzine.com/flip-book/574ef6415d.html"
    }
];

let magIndex = 1;

const magLeft = document.getElementById("magLeft");
const magMain = document.getElementById("magMain");
const magRight = document.getElementById("magRight");

document.getElementById("prevMag").addEventListener("click", () => {
    magIndex = (magIndex - 1 + magazines.length) % magazines.length;
    updateMag();
});

document.getElementById("nextMag").addEventListener("click", () => {
    magIndex = (magIndex + 1) % magazines.length;
    updateMag();
});

function updateMag() {
    const leftIndex = (magIndex - 1 + magazines.length) % magazines.length;
    const rightIndex = (magIndex + 1) % magazines.length;

    const left = magazines[leftIndex];
    const main = magazines[magIndex];
    const right = magazines[rightIndex];

    magMain.src = main.img;
    magLeft.src = left.img;
    magRight.src = right.img;

    document.getElementById("magMainLink").href = main.link;
    document.getElementById("magLeftLink").href = left.link;
    document.getElementById("magRightLink").href = right.link;
}

// --- Video Deck Logic Architecture ---
const videos = [
    {
        id: "n_LEKwGma6g",
        title: "EXPLORE THE FEU TECH CAMPUS!",
        link: "https://www.youtube.com/watch?v=n_LEKwGma6g&source_ve_path=MTc4NDI0"
    },
    {
        id: "d0a2jThLgx4",
        title: "MILES PARAVERSE",
        link: "https://www.youtube.com/watch?v=d0a2jThLgx4"
    },
    {
        id: "N36B85B5xC8",
        title: "\"Hall of Greats\" Music Video",
        link: "https://www.youtube.com/watch?v=N36B85B5xC8"
    }
];

let vidIndex = 1;

const vidLeftThumb = document.getElementById("vidLeftThumb");
const vidMainThumb = document.getElementById("vidMainThumb");
const vidRightThumb = document.getElementById("vidRightThumb");
const vidMainTitle = document.getElementById("vidMainTitle");
const vidMainLink = document.getElementById("vidMainLink");

document.getElementById("prevVid").addEventListener("click", () => {
    vidIndex = (vidIndex - 1 + videos.length) % videos.length;
    updateVid();
});

document.getElementById("nextVid").addEventListener("click", () => {
    vidIndex = (vidIndex + 1) % videos.length;
    updateVid();
});

function updateVid() {
    const leftIndex = (vidIndex - 1 + videos.length) % videos.length;
    const rightIndex = (vidIndex + 1) % videos.length;

    const left = videos[leftIndex];
    const main = videos[vidIndex];
    const right = videos[rightIndex];

    vidLeftThumb.src = `https://img.youtube.com/vi/${left.id}/mqdefault.jpg`;
    vidMainThumb.src = `https://img.youtube.com/vi/${main.id}/maxresdefault.jpg`;
    vidRightThumb.src = `https://img.youtube.com/vi/${right.id}/mqdefault.jpg`;

    vidMainTitle.textContent = main.title;
    vidMainLink.href = main.link;
}

updateMag();
updateVid();
</script>

<script>
document.addEventListener('turbo:load', () => {
    const accordions = document.querySelectorAll('.accordion-item');

    accordions.forEach(item => {
        const button = item.querySelector('.accordion-btn');
        const content = item.querySelector('.accordion-content');
        const icon = item.querySelector('svg');

        button.addEventListener('click', () => {

            accordions.forEach(otherItem => {
                if (otherItem !== item) {
                    otherItem.querySelector('.accordion-content')
                        ?.classList.add('hidden');

                    otherItem.querySelector('svg')
                        ?.classList.remove('rotate-180');
                }
            });

            content.classList.toggle('hidden');
            icon.classList.toggle('rotate-180');
        });
    });
});
</script>
