<script>
document.addEventListener('turbo:load', () => {
    const carousel = document.getElementById('eventsCarousel');
    const prevBtn = document.getElementById('prevCarouselBtn');
    const nextBtn = document.getElementById('nextCarouselBtn');
    const loader = document.getElementById('carouselLoader');
    
    if (!carousel || !prevBtn || !nextBtn || !loader) return;

    const AUTO_PLAY_TIME = 5000; 
    let autoPlayInterval;

    function getScrollAmount() {
        const firstCard = carousel.firstElementChild;
        return firstCard ? firstCard.offsetWidth + 32 : 400; 
    }

    function resetLoaderAnimation() {
        loader.style.transition = 'none';
        loader.style.width = '0%';
        void loader.offsetWidth; 
        loader.style.transition = `width ${AUTO_PLAY_TIME}ms linear`;
        loader.style.width = '100%';
    }

    function handleNextScroll() {
        const maxScroll = carousel.scrollWidth - carousel.clientWidth;
        if (Math.ceil(carousel.scrollLeft) >= maxScroll - 10) {
            carousel.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
            carousel.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
        }
        resetLoaderAnimation();
    }

    function handlePrevScroll() {
        if (carousel.scrollLeft <= 10) {
            carousel.scrollTo({ left: carousel.scrollWidth, behavior: 'smooth' });
        } else {
            carousel.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
        }
        resetLoaderAnimation();
    }

    function startAutoPlay() {
        resetLoaderAnimation();
        autoPlayInterval = setInterval(handleNextScroll, AUTO_PLAY_TIME);
    }

    function stopAutoPlay() {
        clearInterval(autoPlayInterval);
        loader.style.transition = 'none';
        loader.style.width = '0%';
    }

    nextBtn.addEventListener('click', () => {
        stopAutoPlay();
        handleNextScroll();
        startAutoPlay();
    });

    prevBtn.addEventListener('click', () => {
        stopAutoPlay();
        handlePrevScroll();
        startAutoPlay();
    });

    carousel.addEventListener('mouseenter', stopAutoPlay);
    carousel.addEventListener('mouseleave', startAutoPlay);

    startAutoPlay();
});
</script>

<!-- PDF.js library for client-side cover extraction -->
<script src="/flipbook/js/libs/pdf.min.js"></script>
<script>
pdfjsLib.GlobalWorkerOptions.workerSrc = '/flipbook/js/libs/pdf.worker.min.js';
</script>

<script>
const magazines = [
    {% for mag in magazines %}
    {
        pdf: "{{ mag.pdfPath ? (mag.pdfPath starts with '/' or mag.pdfPath starts with 'uploads/' or mag.pdfPath starts with 'http' ? '/' ~ mag.pdfPath : '/uploads/magazines/pdf/' ~ mag.pdfPath) : '' }}"
    }{% if not loop.last %},{% endif %}
    {% endfor %}
];

let magIndex = 0;

document.addEventListener('turbo:load', () => {
    // Inject dfLightBox shim on jQuery if not already defined
    if (window.jQuery && !window.jQuery.dfLightBox && typeof DFLightBox !== "undefined") {
        window.jQuery.dfLightBox = function(options) {
            if (!window.dfLightBox) {
                window.dfLightBox = new DFLightBox(function() {
                    if (window.dfActiveLightBoxBook && window.dfActiveLightBoxBook.dispose) {
                        window.dfActiveLightBoxBook.dispose();
                        window.dfActiveLightBoxBook = null;
                    }
                });
            }
            window.dfLightBox.show(function() {
                window.dfActiveLightBoxBook = window.jQuery(window.dfLightBox.container).flipBook(options.source, {
                    isLightBox: true,
                    transparent: false,
                    height: "100%"
                });
            });
        };
    }

    const magLeft = document.getElementById("magLeft");
    const magMain = document.getElementById("magMain");
    const magRight = document.getElementById("magRight");
    const prevMagBtn = document.getElementById("prevMag");
    const nextMagBtn = document.getElementById("nextMag");

    const leftLink = document.getElementById("magLeftLink");
    const mainLink = document.getElementById("magMainLink");
    const rightLink = document.getElementById("magRightLink");

    if (!magLeft || !magMain || !magRight || !prevMagBtn || !nextMagBtn) return;

    prevMagBtn.addEventListener("click", () => {
        magIndex = (magIndex - 1 + magazines.length) % magazines.length;
        updateMag();
    });

    nextMagBtn.addEventListener("click", () => {
        magIndex = (magIndex + 1) % magazines.length;
        updateMag();
    });

    function openFlipbook(pdfUrl) {
        if (!pdfUrl) return;
        if (window.jQuery && typeof window.jQuery.dfLightBox === "function") {
            window.jQuery.dfLightBox({source: pdfUrl});
        } else {
            window.open(pdfUrl, '_blank');
        }
    }

    if (leftLink) {
        leftLink.addEventListener("click", (e) => {
            e.preventDefault();
            const leftIndex = (magIndex - 1 + magazines.length) % magazines.length;
            const left = magazines[leftIndex];
            if (left) openFlipbook(left.pdf);
        });
    }

    if (mainLink) {
        mainLink.addEventListener("click", (e) => {
            e.preventDefault();
            const main = magazines[magIndex];
            if (main) openFlipbook(main.pdf);
        });
    }

    if (rightLink) {
        rightLink.addEventListener("click", (e) => {
            e.preventDefault();
            const rightIndex = (magIndex + 1) % magazines.length;
            const right = magazines[rightIndex];
            if (right) openFlipbook(right.pdf);
        });
    }

    const pdfCoversCache = {};

    function setMagazineCover(mag, imgElement) {
        if (!mag) return;

        const pdfUrl = mag.pdf;
        if (!pdfUrl) {
            imgElement.src = '';
            return;
        }

        if (pdfCoversCache[pdfUrl]) {
            imgElement.src = pdfCoversCache[pdfUrl];
            return;
        }

        imgElement.src = 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="100" height="150" viewBox="0 0 100 150"><rect width="100%" height="100%" fill="%23f1f5f9"/><text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" font-family="sans-serif" font-size="8" fill="%2394a3b8">Loading Cover...</text></svg>';

        pdfjsLib.getDocument(pdfUrl).promise.then(pdf => {
            return pdf.getPage(1);
        }).then(page => {
            const scale = 1.5;
            const viewport = page.getViewport({ scale: scale });
            const canvas = document.createElement('canvas');
            const context = canvas.getContext('2d');
            canvas.height = viewport.height;
            canvas.width = viewport.width;

            return page.render({ canvasContext: context, viewport: viewport }).promise.then(() => {
                const dataUrl = canvas.toDataURL('image/jpeg', 0.85);
                pdfCoversCache[pdfUrl] = dataUrl;
                imgElement.src = dataUrl;
            });
        }).catch(err => {
            console.error('Error generating PDF cover for ' + pdfUrl, err);
            imgElement.src = 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="100" height="150" viewBox="0 0 100 150"><rect width="100%" height="100%" fill="%23fee2e2"/><text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" font-family="sans-serif" font-size="8" fill="%23ef4444">Error loading cover</text></svg>';
        });
    }

    function updateMag() {
        const leftIndex = (magIndex - 1 + magazines.length) % magazines.length;
        const rightIndex = (magIndex + 1) % magazines.length;

        const left = magazines[leftIndex];
        const main = magazines[magIndex];
        const right = magazines[rightIndex];

        if (main) {
            setMagazineCover(main, magMain);
            if (mainLink) mainLink.href = main.pdf;
        }
        if (left) {
            setMagazineCover(left, magLeft);
            if (leftLink) leftLink.href = left.pdf;
        }
        if (right) {
            setMagazineCover(right, magRight);
            if (rightLink) rightLink.href = right.pdf;
        }
    }

    updateMag();
});
</script>

<script>
document.addEventListener('turbo:load', () => {
    const videos = [
        {% for vid in videos %}
        {
            id: "{{ vid.youtubeId }}",
            title: "{{ vid.title|escape('js') }}",
            link: "{{ vid.linkUrl }}"
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ];

    let activeVideoIndex = 0;

    if (!document.getElementById("youtubePlaylistFeed")) return;

    window.setActiveVideo = function(index) {
        activeVideoIndex = index;
        const currentVideo = videos[activeVideoIndex];

        document.getElementById("vidMainThumb").src = `https://img.youtube.com/vi/${currentVideo.id}/maxresdefault.jpg`;
        document.getElementById("vidMainTitle").textContent = currentVideo.title;
        document.getElementById("vidMainLink").href = currentVideo.link;

        renderPlaylistFeed();
    };

    function renderPlaylistFeed() {
        const feedContainer = document.getElementById("youtubePlaylistFeed");
        if (!feedContainer) return;
        feedContainer.innerHTML = ""; 

        videos.forEach((video, index) => {
            const isCurrentlyPlaying = index === activeVideoIndex;
            
            const itemHTML = `
                <button onclick="setActiveVideo(${index})" class="w-full text-left flex gap-3 p-1.5 rounded-xl transition-all duration-200 ${isCurrentlyPlaying ? 'bg-slate-100 border border-slate-200/80' : 'hover:bg-slate-50 border border-transparent'} focus:outline-none group/item">
                    <div class="w-32 aspect-video rounded-lg overflow-hidden bg-slate-900 flex-shrink-0 relative border border-slate-100 shadow-sm">
                        <img src="https://img.youtube.com/vi/${video.id}/mqdefault.jpg" class="w-full h-full object-cover">
                        ${isCurrentlyPlaying ? `
                            <div class="absolute inset-0 bg-black/45 flex items-center justify-center">
                                <span class="text-[9px] font-extrabold bg-black/80 text-[#f0b323] px-2 py-0.5 rounded tracking-wider border border-white/10">NOW PLAYING</span>
                            </div>
                        ` : ''}
                    </div>
                    <div class="flex flex-col justify-start pt-0.5 overflow-hidden">
                        <h4 class="text-xs font-bold text-slate-800 line-clamp-2 leading-tight group-hover/item:text-slate-950">${video.title}</h4>
                        <span class="text-[10px] text-slate-500 mt-1 font-medium">Tambbayan Tv</span>
                    </div>
                </button>
            `;
            feedContainer.insertAdjacentHTML('beforeend', itemHTML);
        });
    }

    setActiveVideo(0);
});
</script>

<script>
document.addEventListener('turbo:load', () => {
    const accordions = document.querySelectorAll('.accordion-item');

    accordions.forEach(item => {
        const button = item.querySelector('.accordion-btn');
        const content = item.querySelector('.accordion-content');
        const icon = item.querySelector('svg');

        if (button) {
            button.addEventListener('click', () => {
                accordions.forEach(otherItem => {
                    if (otherItem !== item) {
                        otherItem.querySelector('.accordion-content')?.classList.add('hidden');
                        otherItem.querySelector('svg')?.classList.remove('rotate-180');
                    }
                });

                content.classList.toggle('hidden');
                icon.classList.toggle('rotate-180');
            });
        }
    });
});
</script>

