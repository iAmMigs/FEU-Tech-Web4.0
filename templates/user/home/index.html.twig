{% extends 'base.html.twig' %}

{% block title %}{{ page and page.metaTitle ? page.metaTitle : 'School of Innovation | FEU Institute of Technology' }}{% endblock %}
{% block meta_description %}{{ page and page.metaDescription ? page.metaDescription : '' }}{% endblock %}
{% block meta_keywords %}{{ page and page.metaKeywords ? page.metaKeywords : '' }}{% endblock %}

{% block body %}
<section id="top" class="relative w-full h-[85vh] min-h-[650px] flex items-center overflow-hidden bg-slate-950">
    
    <div id="hero-bg-default" class="absolute inset-0 z-0">
        <video autoplay muted loop playsinline class="w-full h-full object-cover select-none pointer-events-none">
            <source src="{{ page and page.heroVideoPath ? (page.heroVideoPath starts with '/' or page.heroVideoPath starts with 'http' ? page.heroVideoPath : '/' ~ page.heroVideoPath) : '/videos/SAMPLEHERO2.mp4' }}" type="video/mp4">
        </video>
        <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/60 to-black/20 md:to-transparent"></div>
    </div>

    <div id="hero-bg-overlay" class="absolute inset-0 z-[1] transition-opacity duration-700 ease-in-out opacity-0 pointer-events-none">
        <img id="hero-bg-overlay-blur" src="" alt="" class="absolute inset-0 w-full h-full object-cover opacity-100">
        <img id="hero-bg-overlay-img" src="" alt="" class="relative z-10 w-full h-full object-contain">
    </div>

    <div id="hero-content" class="relative z-30 w-full max-w-7xl mx-auto px-6 sm:px-4 lg:px-16 flex flex-col justify-center items-start text-left">
        
        <span class="font-roboto text-white font-semibold tracking-[0.2em] uppercase text-xs sm:text-sm mb-4 bg-feu-green/5 px-3 py-1.5 rounded-md inline-block backdrop-blur-sm border border-white/20">
            {{ page and page.heroTagline ? page.heroTagline : 'Welcome to The School of Innovation' }}
        </span>
        
        <h1 class="font-poppins text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold text-white mb-6 leading-[1.4] tracking-wide max-w-4xl" style="text-shadow: 0 4px 16px rgba(0, 0, 0, 0.45), 0 2px 4px rgba(0, 0, 0, 0.3);">
            {{ page and page.heroTitle ? page.heroTitle|striptags : 'Shape Your Future at <span class="text-feu-yellow font-black" style="text-shadow: 0 4px 12px rgba(240, 179, 35, 0.25), 0 2px 4px rgba(0, 0, 0, 0.4);"><br>FEU Tech</span>'|raw }}
        </h1>
        
        <p class="font-roboto text-base md:text-lg lg:text-l text-white mb-10 font-normal leading-relaxed max-w-2xl tracking-wide drop-shadow-md">
            {{ page and page.heroDescription ? page.heroDescription|striptags : 'FEU Tech is an AI Campus and an internationally ranked institution recognized for global excellence in Engineering, Computer Science, I.T., Multimedia Arts and Research. It is committed to producing graduates who are industry-ready and globally competitive from day two.' }}
        </p>
        
        <div class="flex flex-wrap gap-4 w-full sm:w-auto">
            {% if page and page.heroBtn1Text %}
                <a href="{{ page.heroBtn1Url }}" class="w-full sm:w-auto text-center px-8 py-4 bg-white/5 backdrop-blur-md text-feu-yellow font-bold rounded-lg border border-white/20 hover:bg-white/10 hover:border-white/45 active:scale-98 transition-all text-sm tracking-wider font-poppins uppercase shadow-lg">
                    {{ page.heroBtn1Text }}
                </a>
            {% endif %}
            
            {% if page and page.heroBtn2Text %}
                <a href="{{ page.heroBtn2Url }}" class="w-full sm:w-auto text-center px-10 py-4 bg-feu-yellow text-feu-green font-black rounded-lg shadow-2xl shadow-feu-yellow/20 hover:bg-yellow-400 hover:shadow-feu-yellow/45 hover:-translate-y-0.5 active:translate-y-0 transition-all text-sm tracking-wider font-poppins uppercase">
                    {{ page.heroBtn2Text }}
                </a>
            {% endif %}
            
            {% if page and page.heroBtn3Text %}
                <a href="{{ page.heroBtn3Url }}" class="w-full sm:w-auto text-center px-8 py-4 bg-white/5 backdrop-blur-md text-feu-yellow font-bold rounded-lg border border-white/20 hover:bg-white/10 hover:border-white/45 active:scale-98 transition-all text-sm tracking-wider font-poppins uppercase shadow-lg">
                    {{ page.heroBtn3Text }}
                </a>
            {% endif %}
        </div>
        
    </div>
</section>

<section class="relative z-20 -mt-40 pb-8 overflow-hidden">
    <div id="carousel-track-wrapper" class="relative w-full overflow-hidden group/carousel pt-24">

        <div id="carousel-left-arrow" class="absolute left-0 top-1/2 -translate-y-1/2 z-30 flex items-center justify-start transition-opacity duration-300 pointer-events-none mt-8">
            <div class="w-14 h-20 bg-white shadow-lg rounded-r-2xl flex items-center justify-center text-slate-800 pointer-events-auto hover:bg-slate-50 transition-colors border border-slate-100 border-l-0 cursor-pointer">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path>
                </svg>
            </div>
        </div>

        <div id="carousel-right-arrow" class="absolute right-0 top-1/2 -translate-y-1/2 z-30 flex items-center justify-end transition-opacity duration-300 pointer-events-none mt-8">
            <div class="w-14 h-20 bg-white shadow-lg rounded-l-2xl flex items-center justify-center text-slate-800 pointer-events-auto hover:bg-slate-50 transition-colors border border-slate-100 border-r-0 cursor-pointer">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path>
                </svg>
            </div>
        </div>

        <div id="carousel-track" class="flex gap-6 py-6 px-2" style="width: max-content;">

            {% for set in 1..3 %}
            {% for card in carouselCards %}
                <div
                    class="carousel-card group flex-shrink-0 w-[280px] bg-[image:var(--bg-default)] backdrop-blur-md rounded-2xl p-6 shadow-xl drop-shadow-md border border-white/50 cursor-pointer select-none hover:shadow-[0_20px_40px_rgba(0,45,25,0.3)] hover:-translate-y-2 transition-all duration-500 relative hover:[background-image:var(--bg-hover)]"
                    style="
                        --bg-default: linear-gradient(135deg, rgba(254, 201, 44, 0.2), rgba(0, 45, 25, 0.2));
                        --bg-hover: linear-gradient(135deg, rgb(254, 201, 44), rgb(0, 45, 25));
                    "
                    data-carousel-img="{{ card.cardImagePath ? (card.cardImagePath starts with '/' or card.cardImagePath starts with 'http' ? card.cardImagePath : '/' ~ card.cardImagePath) : '' }}"
                    data-hero-bg="{{ card.heroBgPath ? (card.heroBgPath starts with '/' or card.heroBgPath starts with 'http' ? card.heroBgPath : '/' ~ card.heroBgPath) : '' }}"
                >

                <div class="absolute inset-0 opacity-[0.03] bg-[radial-gradient(#000_1px,transparent_1px)] [background-size:16px_16px] pointer-events-none rounded-2xl overflow-hidden group-hover:opacity-10 transition-opacity duration-500"></div>

                <div class="flex items-center gap-4 mb-3 relative z-10">

                    {% if card.logoPath %}
                    <div class="w-12 h-12 rounded-xl bg-white shadow-sm flex items-center justify-center overflow-hidden flex-shrink-0">
                        <img
                            src="{{ card.logoPath starts with '/' or card.logoPath starts with 'http' ? card.logoPath : '/' ~ card.logoPath }}"
                            alt="{{ card.title }}"
                            class="w-10 h-10 object-contain"
                        >
                    </div>
                    {% endif %}

                    <div class="relative z-10">
                        <h4 class="text-base font-bold text-feu-green group-hover:text-white transition-colors duration-500 leading-tight">
                            {{ card.title }}
                        </h4>

                        <p class="text-xs text-slate-700 group-hover:text-slate-100 transition-colors duration-500 mt-0.5 font-medium">
                            {{ card.subtitle }}
                        </p>
                    </div>

                </div>

                <div
                    class="h-1.5 w-0 group-hover:w-full rounded-full transition-all duration-500 absolute bottom-0 left-0"
                    style="background-image: linear-gradient(135deg,rgb(0, 45, 25), rgb(254, 201, 44));"
                ></div>

            </div>
            {% endfor %}
            {% endfor %}

        </div>
    </div>
</section>

<script>
function initCarousel() {
    if (window.homeCarouselInitialized) return;

    const trackWrapper = document.getElementById('carousel-track-wrapper');
    const track = document.getElementById('carousel-track');
    const overlay = document.getElementById('hero-bg-overlay');
    const overlayImg = document.getElementById('hero-bg-overlay-img');
    const overlayBlur = document.getElementById('hero-bg-overlay-blur');
    const heroContent = document.getElementById('hero-content');

    const leftArrow = document.getElementById('carousel-left-arrow')?.firstElementChild;
    const rightArrow = document.getElementById('carousel-right-arrow')?.firstElementChild;

    if (!track || !overlay || !overlayImg || !trackWrapper) return;

    window.homeCarouselInitialized = true;

    const cards = track.querySelectorAll('.carousel-card');
    if (!cards.length) return;

    let scrollPos = 0;
    let baseSpeed = 0.9;
    let isPaused = false;
    let isFastForward = false;
    let isFastRewind = false;
    let resumeTimeout = null;
    let animFrameId = null;

    function getOneSetWidth() {
        const cardCount = cards.length / 3;
        let w = 0;

        for (let i = 0; i < cardCount; i++) {
            w += cards[i].offsetWidth + 24;
        }

        return w;
    }

    /*
    function setupTamTamPersistent() {

        // Remove old tamtams before creating new ones
        track.querySelectorAll('.tamtam-mascot').forEach(el => el.remove());

        const uniqueCardCount = cards.length / 3;
        const uniqueTitles = [];

        for (let i = 0; i < uniqueCardCount; i++) {
            const titleEl = cards[i].querySelector('h4');

            if (titleEl) {
                uniqueTitles.push(titleEl.textContent.trim());
            }
        }

        if (!uniqueTitles.length) return;

        const chosenTitle =
            uniqueTitles[Math.floor(Math.random() * uniqueTitles.length)];

        cards.forEach(card => {
            const titleEl = card.querySelector('h4');

            if (
                titleEl &&
                titleEl.textContent.trim() === chosenTitle
            ) {
                const tamtam = document.createElement('img');

                tamtam.src = '/images/Home_Carousel/TamtamSit.png';

                tamtam.className =
                    'tamtam-mascot absolute -top-20 left-1/2 -translate-x-1/2 w-24 h-24 object-contain z-[100] pointer-events-none opacity-100';

                card.appendChild(tamtam);
            }
        });
    }

    setupTamTamPersistent();
    */
    
    function updateTrackPosition() {
        const oneSet = getOneSetWidth();

        if (scrollPos >= oneSet) {
            scrollPos -= oneSet;
        } else if (scrollPos < 0) {
            scrollPos += oneSet;
        }

        track.style.transform = `translateX(-${scrollPos}px)`;
    }

    function animate() {
        let activeSpeed = 0;

        if (isFastForward) {
            activeSpeed = 4;
        } else if (isFastRewind) {
            activeSpeed = -4;
        } else if (!isPaused) {
            activeSpeed = baseSpeed;
        }

        if (activeSpeed !== 0) {
            scrollPos += activeSpeed;
            updateTrackPosition();
        }

        animFrameId = requestAnimationFrame(animate);
    }

    animFrameId = requestAnimationFrame(animate);

    trackWrapper.addEventListener('mouseenter', () => {
        if (resumeTimeout) {
            clearTimeout(resumeTimeout);
            resumeTimeout = null;
        }

        isPaused = true;
    });

    trackWrapper.addEventListener('mouseleave', () => {
        isFastForward = false;
        isFastRewind = false;

        resumeTimeout = setTimeout(() => {
            isPaused = false;

            overlay.classList.remove('opacity-100');
            overlay.classList.add('opacity-0');

            heroContent.style.opacity = '1';

            resumeTimeout = null;
        }, 1000);
    });

    cards.forEach(card => {
        card.addEventListener('mouseenter', () => {
            const imgSrc = card.getAttribute('data-carousel-img');
            const heroBg = card.getAttribute('data-hero-bg');

            if (imgSrc) {
                overlayImg.src = imgSrc;

                if (overlayBlur) {
                    overlayBlur.src = heroBg;
                }

                overlay.classList.remove('opacity-0');
                overlay.classList.add('opacity-100');

                heroContent.style.opacity = '0';
                heroContent.style.transition = 'opacity 0.5s ease';
            }
        });
    });

    if (leftArrow) {
        leftArrow.addEventListener('mouseenter', () => {
            isFastRewind = true;
        });

        leftArrow.addEventListener('mouseleave', () => {
            isFastRewind = false;
        });

        leftArrow.addEventListener('click', e => {
            e.stopPropagation();

            scrollPos -= 304;
            updateTrackPosition();
        });
    }

    if (rightArrow) {
        rightArrow.addEventListener('mouseenter', () => {
            isFastForward = true;
        });

        rightArrow.addEventListener('mouseleave', () => {
            isFastForward = false;
        });

        rightArrow.addEventListener('click', e => {
            e.stopPropagation();

            scrollPos += 304;
            updateTrackPosition();
        });
    }

    document.addEventListener(
        'turbo:before-render',
        function cleanup() {

            if (animFrameId) {
                cancelAnimationFrame(animFrameId);
            }

            if (resumeTimeout) {
                clearTimeout(resumeTimeout);
            }

            // Remove dynamically-added tamtams before Turbo caches page
            track.querySelectorAll('.tamtam-mascot').forEach(el => el.remove());

            window.homeCarouselInitialized = false;

            document.removeEventListener(
                'turbo:before-render',
                cleanup
            );
        },
        { once: true }
    );
}

document.addEventListener('turbo:load', initCarousel);
document.addEventListener('DOMContentLoaded', initCarousel);

if (
    document.readyState === 'complete' ||
    document.readyState === 'interactive'
) {
    initCarousel();
}
</script>


