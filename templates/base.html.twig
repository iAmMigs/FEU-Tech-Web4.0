        <script>
            (function () {
                function handleScroll() {
                    const header = document.getElementById('main-header');
                    if (!header) return;
                    if (window.scrollY > 10) {
                        header.classList.remove('bg-white', 'shadow-sm');
                        header.classList.add('bg-white/50', 'shadow-md');
                    } else {
                        header.classList.remove('bg-white/50', 'shadow-md');
                        header.classList.add('bg-white', 'shadow-sm');
                    }
                }

                function initializeScrollEffect() {
                    window.removeEventListener('scroll', handleScroll);
                    window.addEventListener('scroll', handleScroll);
                    handleScroll();
                }

                function initializeNavigation() {
                    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
                    const drawerCloseBtn = document.getElementById('drawer-close-btn');
                    const mobileDrawer = document.getElementById('mobile-drawer');
                    const drawerOverlay = document.getElementById('drawer-overlay');
                    const drawerPanel = document.getElementById('drawer-panel');

                    if (!mobileMenuBtn || !mobileDrawer || !drawerOverlay || !drawerPanel) return;
                    
                    // FIX: Check the attribute first before setting it, and don't blindly remove it
                    if (mobileMenuBtn.dataset.initialized === 'true') return;
                    mobileMenuBtn.dataset.initialized = 'true';

                    function openMobileMenu() {
                        mobileDrawer.classList.remove('invisible');
                        requestAnimationFrame(() => {
                            drawerOverlay.classList.remove('opacity-0');
                            drawerOverlay.classList.add('opacity-100');
                            drawerPanel.classList.remove('-translate-x-full');
                            drawerPanel.classList.add('translate-x-0');
                            document.body.classList.add('overflow-hidden');
                        });
                    }

                    function closeMobileMenu() {
                        drawerOverlay.classList.remove('opacity-100');
                        drawerOverlay.classList.add('opacity-0');
                        drawerPanel.classList.remove('translate-x-0');
                        drawerPanel.classList.add('-translate-x-full');
                        setTimeout(() => { mobileDrawer.classList.add('invisible'); }, 300);
                        document.body.classList.remove('overflow-hidden');
                    }

                    mobileMenuBtn.addEventListener('click', openMobileMenu);
                    drawerCloseBtn?.addEventListener('click', closeMobileMenu);
                    drawerOverlay?.addEventListener('click', closeMobileMenu);

                    // Escape key handling
                    const handleKeyDown = (e) => {
                        if (e.key === 'Escape') closeMobileMenu();
                    };
                    document.removeEventListener('keydown', handleKeyDown);
                    document.addEventListener('keydown', handleKeyDown);

                    // Main Accordions
                    const accordions = document.querySelectorAll('.target-accordion');
                    accordions.forEach((accordion) => {
                        if (accordion.dataset.initialized === 'true') return;
                        accordion.dataset.initialized = 'true';
                        
                        accordion.addEventListener('click', function () {
                            const submenu = this.nextElementSibling;
                            const icon = this.querySelector('svg');
                            if (!submenu) return;
                            
                            if (submenu.classList.contains('hidden')) {
                                submenu.classList.remove('hidden');
                                submenu.classList.add('flex');
                                icon?.classList.add('rotate-180');
                            } else {
                                submenu.classList.remove('flex');
                                submenu.classList.add('hidden');
                                icon?.classList.remove('rotate-180');
                            }
                        });
                    });
                }

                function setupNestedAccordions() {
                    const nestedAccordions = document.querySelectorAll('.nested-accordion');
                    nestedAccordions.forEach((accordion) => {
                        if (accordion.dataset.initialized === 'true') return;
                        accordion.dataset.initialized = 'true';
                        
                        accordion.addEventListener('click', function () {
                            const submenu = this.nextElementSibling;
                            const icon = this.querySelector('svg');
                            if (!submenu) return;
                            
                            if (submenu.classList.contains('hidden')) {
                                submenu.classList.remove('hidden');
                                icon?.classList.add('rotate-180');
                            } else {
                                submenu.classList.add('hidden');
                                icon?.classList.remove('rotate-180');
                            }
                        });
                    });
                }

                let loadStartTime = Date.now();
                const MIN_DISPLAY_TIME = 600;

                function hideLoader() {
                    const elapsedTime = Date.now() - loadStartTime;
                    const timeToWait = Math.max(0, MIN_DISPLAY_TIME - elapsedTime);
                    setTimeout(() => {
                        const loader = document.getElementById('page-loader');
                        if (!loader) return;
                        loader.style.opacity = '0';
                        setTimeout(() => { loader.style.display = 'none'; }, 500);
                    }, timeToWait);
                }

                function showLoader() {
                    loadStartTime = Date.now();
                    const loader = document.getElementById('page-loader');
                    if (!loader) return;
                    loader.style.display = 'flex';
                    setTimeout(() => { loader.style.opacity = '1'; }, 10);
                }

                function initAll() {
                    initializeNavigation();
                    setupNestedAccordions();
                    initializeScrollEffect();
                }

                // Runs safely across standard loads and Hotwire Turbo updates
                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', initAll);
                } else {
                    initAll();
                }
                document.addEventListener('turbo:load', initAll);
                
                document.addEventListener('turbo:visit', showLoader);
                document.addEventListener('turbo:load', hideLoader);
                document.addEventListener('turbo:render', hideLoader);
                window.addEventListener('load', hideLoader);
            })();
            </script>
    </body>
</html>