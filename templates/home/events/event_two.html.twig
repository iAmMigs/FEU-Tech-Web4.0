{% extends 'base.html.twig' %}

{% block body %}
<style>
        :root {
            --feu-green: #002d19;
            --feu-yellow: #fdb813;
        }

        .scrollbar-hide::-webkit-scrollbar {
            display: none;
        }

        .scrollbar-hide {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        /* MODAL FIX */
        .image-modal {
            display: none;
        }

        .image-modal.active {
            display: flex;
        }
</style>

<body class="bg-white text-black font-sans">

<header class="relative bg-[var(--feu-green)] text-white overflow-hidden">
    <div class="absolute inset-0 opacity-25 bg-gradient-to-br from-black via-transparent to-[var(--feu-yellow)]"></div>

    <div class="relative max-w-6xl mx-auto px-6 py-20">
        <span class="inline-block px-4 py-1 bg-[var(--feu-yellow)] text-black text-sm font-semibold rounded-full">
            School of Innovation
        </span>

        <h1 class="text-4xl md:text-5xl font-bold mt-4 leading-tight">
            #TaraNaSaPIYU 2026: Welcoming the Next Generation of Innovators at FEU Tech
        </h1>

        <p class="mt-4 text-white/80 text-lg max-w-3xl">
            FEU Institute of Technology Opens Doors to Incoming Freshmen, Parents, and Prospective Tamaraws for Grand Open House
        </p>

        <p class="mt-6 text-sm text-white/70">
            Posted: 2026-05-14
        </p>
    </div>
</header>

<section class="relative z-20 overflow-x-hidden overflow-y-visible bg-slate-50 border-y border-gray-200">
    <div id="carousel-track-wrapper" class="relative w-full overflow-x-hidden overflow-y-visible group/carousel py-20">

        <div id="carousel-left-arrow" class="absolute left-0 top-1/2 -translate-y-1/2 z-30 flex items-center justify-start transition-opacity duration-300 pointer-events-none">
            <div class="w-12 h-16 bg-white/90 backdrop-blur-sm shadow-md rounded-r-xl flex items-center justify-center text-slate-800 pointer-events-auto hover:bg-white transition-colors border border-slate-200 border-l-0 cursor-pointer">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path>
                </svg>
            </div>
        </div>

        <div id="carousel-right-arrow" class="absolute right-0 top-1/2 -translate-y-1/2 z-30 flex items-center justify-end transition-opacity duration-300 pointer-events-none">
            <div class="w-12 h-16 bg-white/90 backdrop-blur-sm shadow-md rounded-l-xl flex items-center justify-center text-slate-800 pointer-events-auto hover:bg-white transition-colors border border-slate-200 border-r-0 cursor-pointer">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path>
                </svg>
            </div>
        </div>

        <div id="carousel-track" class="flex gap-4 px-2" style="width: max-content;">
            {% set images = [
                '/images/carousels/TaraNaSaPIYU/1.jpg',
                '/images/carousels/TaraNaSaPIYU/2.jpg',
                '/images/carousels/TaraNaSaPIYU/3.jpg',
                '/images/carousels/TaraNaSaPIYU/4.jpg',
                '/images/carousels/TaraNaSaPIYU/5.jpg',
                '/images/carousels/TaraNaSaPIYU/6.jpg',
                '/images/carousels/TaraNaSaPIYU/7.jpg'
            ] %}

            {# Randomizer Hook: Multiplied index target for Mascot position #}
            {% set random_target_card = random(1, images|length) %}

            {# Triplicated loops provide seamless boundaries for endless scroll calculations #}
            {% for set_idx in 1..3 %}
            {% for img_path in images %}
                <div
                    class="carousel-card group flex-shrink-0 w-[240px] h-[160px] rounded-xl shadow-md border border-white cursor-pointer select-none hover:-translate-y-1 transition-all duration-300 relative bg-white"
                    data-carousel-img="{{ img_path }}"
                >
                    {% if loop.index == random_target_card %}
                        <img 
                            src="/images/Tamtam/TamtamPic.png"
                            alt="Mascot" 
                            class="absolute -top-[78px] left-4 w-24 h-24 object-contain z-30 pointer-events-none drop-shadow-[0_6px_10px_rgba(0,0,0,0.2)]"
                        >
                    {% endif %}

                    <div class="w-full h-full rounded-xl overflow-hidden relative z-10">
                        <img src="{{ img_path }}" alt="Grand Open House Highlights" class="w-full h-full object-cover">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent pointer-events-none"></div>
                    </div>
                </div>
            {% endfor %}
            {% endfor %}
        </div>
    </div>
</section>

<div id="hover-image-modal" class="image-modal fixed inset-0 z-50 items-center justify-center bg-black/70 backdrop-blur-sm transition-opacity duration-300 opacity-0 cursor-pointer pt-20">
    <div class="relative max-w-2xl max-h-[65vh] p-2 bg-white rounded-2xl shadow-2xl m-4 cursor-default animate-fade-in" onclick="event.stopPropagation()">
        <img id="modal-target-img" src="" alt="Preview Window" class="max-w-full max-h-[60vh] object-contain rounded-xl mx-auto">
        <button id="modal-close-btn" class="absolute top-4 right-4 w-8 h-8 bg-black/60 backdrop-blur-sm text-white rounded-full flex items-center justify-center font-bold text-sm hover:bg-black/80 transition-colors cursor-pointer shadow-lg z-50">&times;</button>
    </div>
</div>

<section class="bg-black text-white">
    <div class="max-w-5xl mx-auto px-6 py-12 text-center">
        <p class="text-xl md:text-2xl font-bold tracking-wide uppercase text-[var(--feu-yellow)] mb-2">
            “Let’s go, Tamaraws! Let’s go!”
        </p>
        <p class="text-sm md:text-base text-white/70 italic">
            — Led by the FEU Men’s Volleyball Team (UAAP Season 88 Silver Medalists)
        </p>
    </div>
</section>

<main class="max-w-6xl mx-auto px-6 py-12 grid md:grid-cols-3 gap-10">

    <article class="md:col-span-2 space-y-6 leading-relaxed text-black/90">

        <p>
            FEU Institute of Technology opened its doors to incoming freshmen, guests, and prospective Tamaraws from across the country—including attendees from as far as <span class="font-semibold text-[var(--feu-green)]">Palawan and Mindoro</span>—for <span class="font-semibold">“#TaraNaSaPIYU: Grand Open House,”</span> offering participants a firsthand experience of student life, academic excellence, and the vibrant community within the School of Innovation.
        </p>

        <p>
            Participants filled the Gymnasium early Saturday morning, eager to immerse themselves in the FEU Tech experience. The event officially commenced with welcome remarks from <span class="font-semibold text-[var(--feu-green)]">Engr. Daryl D. David</span>, Senior Director for Innovation and Research, who highlighted the institution’s commitment to transformative education, a culture of innovation, and a learning environment designed to prepare students for the future.
        </p>

        <p>
            Adding excitement to the opening program, members of the <span class="font-medium text-[var(--feu-green)]">Far Eastern University Men’s Volleyball Team</span>—UAAP Season 88 silver medalists—energized the crowd as they led attendees in FEU’s iconic chant. Their appearance captured the genuine enthusiasm and school spirit that defined the day’s festivities.
        </p>

        <p>
            Throughout the morning, participants explored various venues across the FEU Tech campus, each featuring interactive workshops and immersive learning activities designed to showcase the Institute’s industry-driven programs and hands-on approach to education.
        </p>

        <div class="border-l-4 border-[var(--feu-yellow)] bg-gray-50 p-6 space-y-4">
            <div>
                <h3 class="font-bold text-[var(--feu-green)] mb-1">Engineering & Automation Tracks</h3>
                <p class="text-sm">
                    The <span class="font-medium">Battle of the Boats</span> challenged participants to design and build engineering contraptions capable of staying afloat amid simulated water conditions, encouraging teamwork, creativity, and problem-solving. Meanwhile, the <span class="font-medium">Lego Robotics workshop</span>, facilitated by Computer Engineering Assistant Director <span class="font-medium">Engr. Jamie Jamasali</span>, introduced attendees to automation and intelligent machines.
                </p>
            </div>
            <div>
                <h3 class="font-bold text-[var(--feu-green)] mb-1">Digital Media & Gaming Tracks</h3>
                <p class="text-sm">
                    Spearheaded by <span class="font-medium">Neun Farben</span>, the <span class="font-medium">Level Up: E-Sports Experience</span> workshop provided valuable insights into professional game development, digital strategy, and animation. Aspiring content creators likewise participated in a hands-on workshop facilitated by FEU Tech’s student-led multimedia organization, <span class="font-medium">TAMbayan TV</span>, focusing on storytelling and digital media production.
                </p>
            </div>
        </div>

        <p>
            Aside from the much-anticipated free <span class="font-bold text-[var(--feu-green)]">FEU Tech College Admissions Test (FEUCAT)</span> held in the afternoon, the Open House also allowed prospective students and parents to tour the campus and explore the wide range of academic programs, student organizations, and career pathways available at FEU Tech.
        </p>

        <p>
            Through program showcases, interactive demonstrations, and direct engagement with faculty members and student leaders, the event highlighted the institution’s strong emphasis on innovation, collaboration, and industry-ready education. It served as a meaningful introduction to college life—offering future Tamaraws a glimpse into a premier tech ecosystem.
        </p>

    </article>

    <aside class="space-y-6">

        <div class="bg-[var(--feu-green)] text-white p-6 rounded-xl">
            <h3 class="font-bold mb-3 text-[var(--feu-yellow)]">Featured Interactive Workshops</h3>
            <ul class="text-sm space-y-3 text-white/80">
                <li>• <strong class="text-white">Battle of the Boats</strong><br><span class="text-xs text-white/60">Mechanical Design & Problem Solving</span></li>
                <li>• <strong class="text-white">Lego Robotics</strong><br><span class="text-xs text-white/60">Fundamentals of Robotics & Automation</span></li>
                <li>• <strong class="text-white">Level Up: E-Sports Experience</strong><br><span class="text-xs text-white/60">Game Development & Animation Production</span></li>
                <li>• <strong class="text-white">TAMbayan TV Sessions</strong><br><span class="text-xs text-white/60">Storytelling & Digital Content Creation</span></li>
            </ul>
        </div>

        <div class="bg-[var(--feu-yellow)] text-black p-6 rounded-xl">
            <h3 class="font-bold mb-2">Admissions & Tours</h3>
            <ul class="text-sm space-y-2 font-medium">
                <li>• Free Afternoon FEUCAT Session</li>
                <li>• Guided Infrastructure & Campus Tours</li>
                <li>• Faculty-Led Program Showcases</li>
                <li>• Student Organization Engagement</li>
            </ul>
        </div>

    </aside>

</main>

<footer class="bg-[var(--feu-green)] text-white py-12 text-center">
    <h3 class="text-xl font-bold">Start Your Innovation Journey With Us</h3>
    <p class="text-white/70 mt-2">
        Be part of a community that continues to redefine technology and education landscapes.
    </p>
</footer>

<script>
function initCarousel() {
    if (window.carouselInitialized) return;
    
    const trackWrapper = document.getElementById('carousel-track-wrapper');
    const track = document.getElementById('carousel-track');
    const modal = document.getElementById('hover-image-modal');
    const modalImg = document.getElementById('modal-target-img');
    const closeBtn = document.getElementById('modal-close-btn');
    
    const leftArrow = document.getElementById('carousel-left-arrow')?.firstElementChild;
    const rightArrow = document.getElementById('carousel-right-arrow')?.firstElementChild;

    if (!track || !modal || !modalImg || !trackWrapper) return;
    
    window.carouselInitialized = true;

    const cards = track.querySelectorAll('.carousel-card');
    if (!cards.length) return;

    let scrollPos = 0;
    let baseSpeed = 0.9;       
    let isPaused = false;      
    let isFastForward = false;
    let isFastRewind = false;
    let animFrameId = null;

    function getOneSetWidth() {
        const cardCount = cards.length / 3;
        let w = 0;
        for (let i = 0; i < cardCount; i++) {
            w += cards[i].offsetWidth + 16;
        }
        return w;
    }

    function updateTrackPosition() {
        const oneSet = getOneSetWidth();
        if (scrollPos >= oneSet) {
            scrollPos -= oneSet;
        } else if (scrollPos < 0) {
            scrollPos += oneSet;
        }
        track.style.transform = `translateX(-${scrollPos}px)`;
    }

    function animate() {
        let activeSpeed = 0;
        
        if (isFastForward) {
            activeSpeed = 4;
        } else if (isFastRewind) {
            activeSpeed = -4;
        } else if (!isPaused) {
            activeSpeed = baseSpeed;
        }

        if (activeSpeed !== 0) {
            scrollPos += activeSpeed;
            updateTrackPosition();
        }
        
        animFrameId = requestAnimationFrame(animate);
    }

    animFrameId = requestAnimationFrame(animate);

    trackWrapper.addEventListener('mouseenter', () => {
        isPaused = true;
    });

    trackWrapper.addEventListener('mouseleave', () => {
        isFastForward = false;
        isFastRewind = false;
        isPaused = false;
    });

    function closeModal() {
        modal.classList.remove('active', 'opacity-100');
        modal.classList.add('opacity-0');
    }

    cards.forEach(card => {
        card.addEventListener('click', (e) => {
            e.stopPropagation();
            const imgSrc = card.getAttribute('data-carousel-img');
            if (imgSrc) {
                modalImg.src = imgSrc;
                modal.classList.add('active', 'opacity-100');
                modal.classList.remove('opacity-0');
            }
        });
    });

    modal.addEventListener('click', closeModal);
    if (closeBtn) closeBtn.addEventListener('click', closeModal);

    if (leftArrow) {
        leftArrow.addEventListener('mouseenter', () => isFastRewind = true);
        leftArrow.addEventListener('mouseleave', () => isFastRewind = false);
        leftArrow.addEventListener('click', (e) => {
            e.stopPropagation();
            scrollPos -= 256; 
            updateTrackPosition();
        });
    }
    
    if (rightArrow) {
        rightArrow.addEventListener('mouseenter', () => isFastForward = true);
        rightArrow.addEventListener('mouseleave', () => isFastForward = false);
        rightArrow.addEventListener('click', (e) => {
            e.stopPropagation();
            scrollPos += 256; 
            updateTrackPosition();
        });
    }

    document.addEventListener('turbo:before-render', function cleanup() {
        if (animFrameId) cancelAnimationFrame(animFrameId);
        document.removeEventListener('turbo:before-render', cleanup);
        window.carouselInitialized = false;
    }, { once: true });
}

document.addEventListener('turbo:load', initCarousel);
document.addEventListener('DOMContentLoaded', initCarousel);
if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initCarousel();
}
</script>

</body>
{% endblock %}