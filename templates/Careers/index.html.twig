                            </button>
                            
                            <div class="flex items-center gap-3 mb-4">
                                <span class="px-3 py-1 bg-white border border-slate-200 text-slate-600 text-xs font-bold uppercase tracking-wider rounded-full shadow-sm">{{ job.department }}</span>
                                <span class="px-3 py-1 bg-green-50 text-feu-green text-xs font-bold uppercase tracking-wider rounded-full">{{ job.type }}</span>
                            </div>
                            <h2 class="text-3xl md:text-4xl font-black text-slate-900">{{ job.title }}</h2>
                        </div>

                        <!-- Modal Body -->
                        <div class="p-8 overflow-y-auto">
                            {% if job.image is defined and job.image is not null %}
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
                                    <!-- Left Column: Official Poster -->
                                    <div class="flex flex-col items-center justify-center bg-slate-50 rounded-2xl p-4 border border-slate-100 shadow-inner group sticky top-0">
                                        <div class="relative overflow-hidden rounded-xl border border-slate-200 shadow-sm transition-transform duration-300 group-hover:scale-[1.02] cursor-pointer" onclick="openLightbox('{{ job.image }}')">
