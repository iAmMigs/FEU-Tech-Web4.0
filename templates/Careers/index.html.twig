{% extends 'base.html.twig' %}

{% block title %}Careers | FEU Institute of Technology{% endblock %}

{% block body %}
<style>
    :root {
        --feu-green: #008348;
        --feu-yellow: #febe10;
    }

    html {
        scroll-behavior: smooth;
    }

    /* Modal Animation */
    .modal-enter {
        opacity: 0;
        transform: scale(0.95);
    }
    .modal-enter-active {
        opacity: 1;
        transform: scale(1);
        transition: opacity 300ms ease-out, transform 300ms ease-out;
    }
    .modal-exit {
        opacity: 1;
        transform: scale(1);
    }
    .modal-exit-active {
        opacity: 0;
        transform: scale(0.95);
        transition: opacity 200ms ease-in, transform 200ms ease-in;
    }
</style>

<!-- Hero Section -->
<section class="relative w-full py-24 min-h-[500px] flex items-center justify-center overflow-hidden">
    <!-- Background Imagery -->
    <div class="absolute inset-0 z-0">
        <img src="/images/facility/campus_facilities_1.jpg" alt="Campus Facilities" class="w-full h-full object-cover">
        <!-- Strong, consistent green tint across the whole background -->
        <div class="absolute inset-0 bg-[#008348] opacity-80 mix-blend-multiply"></div>
        <div class="absolute inset-0 bg-[#008348] opacity-40"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full flex flex-col md:flex-row items-center justify-between gap-12">
        <div class="md:w-1/2 text-left">
            <span class="text-feu-yellow font-black tracking-[0.3em] uppercase text-sm mb-4 block drop-shadow-md">
                Join Our Team
            </span>
            <h1 class="text-6xl md:text-8xl font-black text-feu-yellow leading-none tracking-tighter mb-2 drop-shadow-lg">
                WE'RE
            </h1>
            <h1 class="text-7xl md:text-9xl font-black text-white leading-none tracking-tighter mb-6 drop-shadow-lg">
                HIRING
            </h1>
            <p class="text-green-50 text-xl font-medium max-w-lg leading-relaxed mb-8">
                Be part of an institution driven by innovation. Shape the future of technology and education with us.
            </p>
            <a href="#open-positions" class="inline-flex items-center gap-2 bg-feu-yellow text-slate-900 px-8 py-4 rounded-full font-black uppercase tracking-wider hover:bg-white transition-colors shadow-xl hover:shadow-2xl transform hover:-translate-y-1 duration-300">
                View Open Positions
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
            </a>
        </div>
        
        <div class="md:w-1/2 relative hidden md:block">
            <!-- Megaphone Tammy Hero -->
            <div class="relative w-full h-[450px] flex items-end justify-center">
                <img src="/images/Tamtam/Megaphone_Tammy.png" alt="Megaphone Tammy" class="relative z-10 w-[400px] h-auto drop-shadow-2xl transform hover:scale-105 transition-transform duration-500">
            </div>
        </div>
    </div>
</section>

