                                                <svg class="w-12 h-12 text-white drop-shadow-lg" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path></svg>
                                            </div>
                                            <img src="{{ job.image }}" alt="Official Job Posting Poster" class="w-full h-auto max-h-[600px] object-contain relative z-0">
                                        </div>
                                        <p class="text-xs text-slate-400 mt-3 flex items-center gap-1 font-medium tracking-wide">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                                            Official HRO Posting Poster
                                        </p>
                                    </div>
                                    
                                    <!-- Right Column: Qualifications List -->
                                    <div>
                                        <h4 class="text-xl font-bold text-slate-800 mb-6 flex items-center gap-2">
                                            <svg class="w-6 h-6 text-feu-yellow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                            Qualifications:
                                        </h4>
                                        <ul class="space-y-4">
                                            {% for qual in job.qualifications %}
