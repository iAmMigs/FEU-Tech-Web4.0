{% extends 'base.html.twig' %}

{% block body %}
<section id="top" class="relative w-full h-[20vh] min-h-[200px] flex items-end justify-center overflow-hidden">
    <div class="absolute inset-0 z-0">
        <img src="/images/history/1936.jpg"
             alt="Hero Background"
             class="w-full h-full object-cover opacity-80 mix-blend-multiply">
        <div class="absolute inset-0 bg-slate-900/60 mix-blend-multiply"></div>
    </div>
    <div class="relative z-10 text-center px-5 max-w-4xl mx-auto pb-10 md:pb-18">
        <h1 class="text-5xl md:text-7xl font-extrabold text-white mb-6 leading-tight drop-shadow-lg">
            History of <span class="feu-gradient-text">FEU Tech</span>
        </h1>
    </div>
</section>

<!-- Flow-up animation applied to this section -->
<section class="bg-[#fdfdfd] py-20 px-6 border-b border-gray-100 reveal-on-scroll opacity-0 translate-y-10 transition-all duration-1000 ease-out">
    <div class="max-w-7xl mx-auto">

        <!-- HEADER -->
        <div class="flex flex-col md:flex-row items-center justify-between mb-16 gap-8">
            <div class="max-w-2xl">
                <h2 class="text-green-800 font-bold tracking-widest uppercase text-sm mb-2">
                    Campus Heritage
                </h2>

                <h1 class="text-4xl md:text-6xl font-serif text-slate-900 leading-tight">
                    The Evolution of <br>
                    <span class="text-green-700">Institutional Identity</span>
                </h1>
            </div>
        </div>

        <!-- GRID -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-10">

            <!-- CARD 1 -->
            <div class="flex flex-col items-center text-center">
                <!-- IMAGE -->
                <div class="w-full aspect-square max-w-[280px] mb-8 relative p-8 bg-white rounded-full shadow-inner border border-gray-50 flex items-center justify-center overflow-hidden">
                    <img src="/images/history/logo (3).png"
                         class="w-full h-full object-contain"
                         alt="">
                </div>

                <!-- TITLE ROW (aligned across all cards) -->
                <div class="h-20 flex items-center justify-center px-2">
                    <h3 class="text-2xl font-bold text-green-900 uppercase tracking-tighter leading-tight">
                        East Asia College of Information Technology
                    </h3>
                </div>

                <!-- PARAGRAPH ROW (aligned across all cards) -->
                <div class="h-28 flex items-start justify-center px-4">
                    <p class="text-slate-600 leading-relaxed text-sm">
                        The original logo represented the institution’s foundation as a pioneering college focused on information technology education.
                    </p>
                </div>
            </div>

            <!-- CARD 2 -->
            <div class="flex flex-col items-center text-center">
                <div class="w-full aspect-square max-w-[280px] mb-8 relative p-8 bg-white rounded-full shadow-inner border border-gray-50 flex items-center justify-center overflow-hidden">
                    <img src="/images/history/logo (2).png"
                         class="w-full h-full object-contain"
                         alt="">
                </div>

                <div class="h-20 flex items-center justify-center px-2">
                    <h3 class="text-2xl font-bold text-green-900 uppercase tracking-tighter leading-tight">
                        FEU East Asia College
                    </h3>
                </div>

                <div class="h-28 flex items-start justify-center px-4">
                    <p class="text-slate-600 leading-relaxed text-sm">
                        This redesigned logo reflected the school’s integration with the FEU system while maintaining its commitment to academic excellence and innovation.
                    </p>
                </div>
            </div>

            <!-- CARD 4 -->
            <div class="flex flex-col items-center text-center">
                <div class="w-full aspect-square max-w-[280px] mb-8 relative p-8 bg-white rounded-full shadow-inner border border-gray-50 flex items-center justify-center overflow-hidden">
                    <img src="/images/history/logo (4).jpg"
                         class="w-full h-full object-contain"
                         alt="">
                </div>

                <div class="h-20 flex items-center justify-center px-2">
                    <h3 class="text-2xl font-bold text-green-900 uppercase tracking-tighter leading-tight">
                        Far Eastern University Institute of Technology
                    </h3>
                </div>

                <div class="h-28 flex items-start justify-center px-4">
                    <p class="text-slate-600 leading-relaxed text-sm">
                        A modernized identity that reflects technological advancement, leadership, and the university’s commitment to engineering and innovation.
                    </p>
                </div>
            </div>

            <!-- CARD 3 -->
            <div class="flex flex-col items-center text-center">
                <div class="w-full aspect-square max-w-[280px] mb-8 relative p-8 bg-white rounded-full shadow-inner border border-gray-50 flex items-center justify-center overflow-hidden">
                    <img src="/images/Tech_Logo.png"
                         class="w-full h-full object-contain"
                         alt="">
                </div>

                <div class="h-20 flex items-center justify-center px-2">
                    <h3 class="text-2xl font-bold text-green-900 uppercase tracking-tighter leading-tight">
                        FEU Institute of Technology (1992)
                    </h3>
                </div>

                <div class="h-28 flex items-start justify-center px-4">
                    <p class="text-slate-600 leading-relaxed text-sm">
                        The current logo symbolizes the institution’s growth into a premier technology and engineering school under the FEU brand.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- NEW DESIGN SECTION: EYE-CATCHING ACADEMIC FOUNDATIONS SHOWCASE -->
<section class="bg-gradient-to-b from-[#fdfdfd] to-[#fffdf0] py-24 px-6 overflow-hidden reveal-on-scroll opacity-0 translate-y-10 transition-all duration-1000 ease-out">
    <div class="max-w-7xl mx-auto">
        
        <!-- SECTION TITLE -->
        <div class="text-center mb-20 relative">
            <span class="text-green-800 font-bold tracking-[0.25em] uppercase text-xs block mb-3">Institutional Handbook Insights</span>
            <h2 class="text-4xl md:text-5xl font-serif text-slate-900 leading-tight">
                Academic Pillars & <br class="md:hidden"> <span class="text-green-700 font-sans font-extrabold not-italic">Strategic Foundations</span>
            </h2>
            <div class="w-24 h-1 bg-[#febe10] mx-auto mt-6 rounded-full"></div>
        </div>

        <!-- FOUNDATION GRID -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 relative z-10">
            
            <!-- CARD 1: GLOBAL BENCHMARKING -->
            <div class="bg-white/80 backdrop-blur-sm p-8 rounded-2xl border border-gray-100 shadow-lg hover:shadow-xl hover:-translate-y-2 transition-all duration-300 flex flex-col justify-between group">
                <div>
                    <div class="w-14 h-14 bg-green-50 rounded-xl flex items-center justify-center mb-6 text-green-700 group-hover:bg-green-700 group-hover:text-white transition-all duration-300 shadow-sm">
                        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path></svg>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-green-800 transition-colors">Global Curricular Standards</h3>
                    <p class="text-slate-600 text-sm leading-relaxed mb-6">
                        Engineered to meet real-world complexities, the educational tracks mirror frameworks from elite global giants like the <span class="font-semibold text-slate-800">Massachusetts Institute of Technology (MIT)</span>, University of Michigan, Cornell, and California Polytechnic, adjusted directly to fuel local Philippine technological updates.
                    </p>
                </div>
                <div class="flex flex-wrap gap-2 pt-4 border-t border-gray-50">
                    <span class="bg-slate-100 text-slate-700 text-[10px] uppercase font-bold px-2.5 py-1 rounded">MIT Aligned</span>
                    <span class="bg-slate-100 text-slate-700 text-[10px] uppercase font-bold px-2.5 py-1 rounded">Global Scope</span>
                </div>
            </div>

            <!-- CARD 2: FORMAL INFRASTRUCTURE -->
            <div class="bg-white/80 backdrop-blur-sm p-8 rounded-2xl border border-gray-100 shadow-lg hover:shadow-xl hover:-translate-y-2 transition-all duration-300 flex flex-col justify-between group">
                <div>
                    <div class="w-14 h-14 bg-amber-50 rounded-xl flex items-center justify-center mb-6 text-[#d99b00] group-hover:bg-[#febe10] group-hover:text-slate-900 transition-all duration-300 shadow-sm">
                        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-amber-800 transition-colors">Formidable Infrastructure</h3>
                    <p class="text-slate-600 text-sm leading-relaxed mb-6">
                        Backed by a formidable faculty mix of theoretical scientists and field-hardened consulting engineers. Growth initiatives systematically funded laboratory developments, cementing structural outputs across a key <span class="font-semibold text-slate-800">7-storey Technology Facility in Manila</span> alongside a sprawling asset cluster on the <span class="font-semibold text-slate-800">46-hectare Quezon City Campus</span>.
                    </p>
                </div>
                <div class="flex flex-wrap gap-2 pt-4 border-t border-gray-50">
                    <span class="bg-amber-50 text-amber-800 text-[10px] uppercase font-bold px-2.5 py-1 rounded">7-Storey Manila</span>
                    <span class="bg-amber-50 text-amber-800 text-[10px] uppercase font-bold px-2.5 py-1 rounded">46-Hectare QC</span>
                </div>
            </div>

            <!-- CARD 3: ACADEMIC MODEL -->
            <div class="bg-white/80 backdrop-blur-sm p-8 rounded-2xl border border-gray-100 shadow-lg hover:shadow-xl hover:-translate-y-2 transition-all duration-300 flex flex-col justify-between group">
                <div>
                    <div class="w-14 h-14 bg-blue-50 rounded-xl flex items-center justify-center mb-6 text-feu-green group-hover:bg-feu-green group-hover:feu-green transition-all duration-300 shadow-sm">
                        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.783 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-feu-green transition-colors">The Modern Trimestral Engine</h3>
                    <p class="text-slate-600 text-sm leading-relaxed mb-6">
                        Re-established engineering frameworks transitioned the foundational operations over to a highly efficient, production-speed <span class="font-semibold text-slate-800">Trimestral System</span>. Students systematically fulfill deep structural competencies in under 4 years and 1 term, reinforced by a mandatory <span class="font-semibold text-slate-800">3.5-month structured industry immersion program</span>.
                    </p>
                </div>
                <div class="flex flex-wrap gap-2 pt-4 border-t border-gray-50">
                    <span class="bg-blue-50 text-feu-green text-[10px] uppercase font-bold px-2.5 py-1 rounded">Trimestral Execution</span>
                    <span class="bg-blue-50 text-feu-green text-[10px] uppercase font-bold px-2.5 py-1 rounded">3.5-Mo. Immersion</span>
                </div>
            </div>

        </div>
    </div>
</section>

<div style="background: linear-gradient(to bottom, #ffffff 2%, #fffee0 100%);" class="pt-20 pb-10">
    <div class="flex flex-col items-center text-center">
        <h2 class="text-green-800 font-bold tracking-[0.3em] uppercase text-xs mb-3">FEU Institute of Technology</h2>
        <h1 class="text-4xl md:text-6xl font-serif text-slate-900 mb-6 italic"> Timeline</h1>
        <div class="w-16 h-1 bg-[#febe10]"></div>
    </div>
</div>


<!-- TIMELINE CONTAINER: Yellow fades to white within the top 1/8 (12.5%) of this section -->
<div class="min-h-screen py-12 px-4 md:px-10" 
     style="background: linear-gradient(to bottom, #fffee0 8%, #ffffff 12.5%, #ffffff 100%);">

    <div class="relative max-w-7xl mx-auto" id="timeline">

        <div class="absolute left-1/2 transform -translate-x-1/2 h-full border-l-4 border-green-200"></div>

        <div id="timeline-line"
             class="absolute left-1/2 transform -translate-x-1/2 top-0 w-[4px] bg-green-700 h-0 transition-all duration-300 z-10">
        </div>

        <div class="space-y-16">

            {% set timeline = [
                { 'date': '1936', 'content': 'The Commonwealth was two years old and independence was promised a decade hence. The FEU, a private education pioneer, took stock of the emergent nation’s needs. Among its findings was a very pressing need for engineers and technologists to help build the nation. It felt itself challenged and it thus established the Institute of Technology. An increasing demand for trained engineers and technologists remained. With the government’s accelerated economic recovery program, private businesses establishing more and more factories, and agriculture shifting to mechanization, the demand for trained and skilled personnel was greater than ever. The Institute of Technology helped by filling the country’s needs in this respect.', 'image': '/images/history/1936.jpg' },
                { 'date': '1936', 'content': 'When it was founded, the Institute of Technology initially offered a complete course in civil engineering. The Institute has since added complete courses in six other major fields of technology: architecture, chemical engineering, mechanical engineering, electrical engineering, industrial engineering, and chemistry. Curricula were structured identically to world premier giants like MIT, Cornell, and CalPoly, backed by a formidable faculty composed of the nation’s esteemed technical educators, scholars, and practicing professional consulting engineers.', 'image': '/images/history/1930.jpg' },
                { 'date': '1952', 'content': 'A course in geodetic engineering was also started. In line with a continuous facility expansion policy around this peak historical era, FEU built a foundational seven-storey Technology Building in Manila along with a major layout complex across its 46-hectare Quezon City campus to maintain the country’s most modern laboratory resources.', 'image': '/images/history/1960.jpg' },
                { 'date': '1971', 'content': 'The Department of Architecture was elevated into the Institute of Architecture and Fine Arts and took over the architecture program.', 'image': '/images/history/1945.jpg' },
                { 'date': '1978', 'content': 'The course in chemistry was transferred to the Institute of Arts and Sciences.', 'image': '/images/history/1978.jpg' },
                { 'date': '1991', 'content': 'SM Foundation and IBM Philippines set up the Asia Pacific Computer Technology Center (APCTC). Six months later, APCTC collaborated with Far Eastern University (FEU) and Intelligent Wave, Inc. (IWI) and set up a computer school, which was subsequently called East Asia Computer Center. Later, the name was changed to East Asia Institute of Computer Technology (EAICT). Initially, the only degree offered was a Bachelor of Science in Computer and Information Science (BSCIS). Concurrently, engineering operations faced a massive transition shift as the legacy Board of Directors systematically stopped accepting engineering freshmen this same year.', 'image': '/images/history/1991.jpg' },
                { 'date': '1992', 'content': 'FEU takes pride in its relentless efforts for academic excellence. For this reason, it conducts a constant review of programs of major tertiary courses. After a thorough study of the Technology Program, the administration decided to phase it out in favor of a computer technology program forged with East Asia Computer Center, Inc., which offered degrees in Computer Science.', 'image': '/images/history/1992.png' },
                { 'date': '1994', 'content': 'EAICT started to offer the degree of Bachelor of Science in Computer Engineering (BSCOE).', 'image': '/images/history/1994.jpg' },
                { 'date': '1996', 'content': 'Despite still holding a major baseline enrollment of over 4,000 active students, the legacy Institute of Technology found itself caught in a structural economic squeeze between strict government caps on tuition fee increases and escalating costs required to support high-tier engineering standards. Refusing to let quality plummet, FEU elected to close the legacy unit down.', 'image': '/images/history/1998.jpg' },
                { 'date': 'September 30, 1998', 'content': 'The Commission on Higher Education (CHED) noted the change in the name of East Asia Institute of Computer Technology (EAICT) to East Asia College of Information Technology (EACIT).', 'image': '/images/history/1998.jpg' },
                { 'date': 'February 24, 2000', 'content': 'EACIT reached a key milestones as it was officially designated by CHED as a Center of Development for Excellence (CODE) in Information Technology Education throughout the National Capital Region (NCR).', 'image': '/images/history/2000.jpg' },
                { 'date': '2001', 'content': 'EACIT sought approval of CHED for additional courses leading to BSIT and BSIM tracks. Simultaneously, FEU administrators moved to fully rehabilitate and revive the engineering program, launching the modern College of Engineering (BSCE, BSEE, BSECE, BSIE) under a trimestral calendar system, allowing standard graduation paths in 4 years and 1 single term (inclusive of a 3.5-month industry immersion).', 'image': '/images/history/2001.jpg' },
                { 'date': '2002', 'content': 'FEU acquired the controlling stock of EACIT.', 'image': '/images/history/2002.jpg' },
                { 'date': '2003', 'content': 'FEU merged Engineering and EACIT forming FEU–EAC.', 'image': '/images/history/2003.jpg' },
                { 'date': 'April 12, 2004', 'content': 'The re-established College of Engineering formally received its structural Government Recognitions from the Commission on Higher Education (CHED) to fully operate its four principal programs (BSCE, BSEE, BSECE, BSIE), while the IT expansions initiated in 2001 secured full official recognition in the same month.', 'image': '/images/history/2014.jpg' },
                { 'date': '2014', 'content': 'FEU–EAC was renamed FEU Institute of Technology (FEU Tech).', 'image': '/images/history/2014.jpg' }
            ] %}

            {% for item in timeline %}
                {% set isRight = loop.index is even %}

                <div class="relative timeline-item opacity-0 transition-all duration-700 ease-out group flex"
                     data-index="{{ loop.index0 }}">

                    <div class="w-1/2 flex justify-end pr-10">
                        <div class="max-w-md w-full flex flex-col">
                            {% if not isRight %}
                                <h2 class="text-2xl font-extrabold text-green-600 mb-3 text-right group-hover:text-[#febe10] transition">
                                    {{ item.date }}
                                </h2>

                                <div class="flex-1 bg-white rounded-lg shadow-md p-5 border-r-2 border-green-200 flex items-center justify-center text-right group-hover:bg-[#008348] group-hover:text-white transition-all duration-300">
                                    <p>{{ item.content }}</p>
                                </div>
                            {% else %}
                                <div class="mb-3 h-8"></div>

                                <div class="flex-1 overflow-hidden rounded-xl shadow-xl bg-gray-100">
                                    <img src="{{ item.image }}"
                                         class="w-full h-full object-cover transition duration-500 group-hover:scale-105">
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    <div class="w-16 flex flex-col items-center marker-container relative z-20">
                        <div class="h-11"></div>

                        <div class="flex-1 w-full relative flex items-center justify-center">

                            <span class="timeline-dot absolute w-6 h-6 rounded-full bg-green-600 border-4 border-white shadow-lg z-10 transition-all duration-300"></span>

                            <img src="/images/readingtamtam2.gif"
                                 class="timeline-gif absolute w-14 h-14 object-contain opacity-0 scale-75 transition-all duration-300 z-20 pointer-events-none rounded-full border-4 border-transparent bg-white">
                        </div>
                    </div>

                    <div class="w-1/2 flex justify-start pl-10">
                        <div class="max-w-md w-full flex flex-col">
                            {% if isRight %}
                                <h2 class="text-2xl font-extrabold text-green-600 mb-3 text-left group-hover:text-[#febe10] transition">
                                    {{ item.date }}
                                </h2>

                                <div class="flex-1 bg-white rounded-lg shadow-md p-5 border-l-2 border-green-200 flex items-center justify-center text-left group-hover:bg-[#008348] group-hover:text-white transition-all duration-300">
                                    <p>{{ item.content }}</p>
                                </div>
                            {% else %}
                                <div class="mb-3 h-8"></div>

                                <div class="flex-1 overflow-hidden rounded-xl shadow-xl bg-gray-100">
                                    <img src="{{ item.image }}"
                                         class="w-full h-full object-cover transition duration-500 group-hover:scale-105">
                                </div>
                            {% endif %}
                        </div>
                    </div>

                </div>
            {% endfor %}

        </div>
    </div>
</div>

<script>
    const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.remove('opacity-0', 'translate-y-10');
                entry.target.classList.add('opacity-100', 'translate-y-0');
            }
        });
    }, { threshold: 0.1 });

    document.querySelectorAll('.reveal-on-scroll').forEach(section => revealObserver.observe(section));


    const items = document.querySelectorAll('.timeline-item');
    const line = document.getElementById('timeline-line');
    const timeline = document.getElementById('timeline');

    const updateLine = () => {

        let activeIndex = -1;
        const viewportMiddle = window.innerHeight / 2;

        items.forEach((item, index) => {
            const rect = item.getBoundingClientRect();
            if (rect.top < viewportMiddle) {
                activeIndex = index;
            }
        });

        const timelineTop =
            timeline.getBoundingClientRect().top + window.scrollY;

        if (activeIndex < 0) {
            line.style.height = '0px';
        } else {
            if (activeIndex === items.length - 1) {
                const timelineBottom =
                    timeline.getBoundingClientRect().bottom + window.scrollY;
                line.style.height =
                    (timelineBottom - timelineTop) + 'px';
            } else {
                const currentItem = items[activeIndex];
                const dot = currentItem.querySelector('.timeline-dot');
                const dotCenter =
                    dot.getBoundingClientRect().top +
                    window.scrollY +
                    (dot.offsetHeight / 2);
                line.style.height =
                    (dotCenter - timelineTop) + 'px';
            }
        }

        items.forEach((item, index) => {
            const dot = item.querySelector('.timeline-dot');
            const gif = item.querySelector('.timeline-gif');

            if (index === activeIndex) {
                dot.classList.add('opacity-0', 'scale-0');
                gif.classList.remove('opacity-0', 'scale-75', 'border-transparent');
                gif.classList.add('opacity-100', 'scale-100', 'border-green-500');
            } else {
                dot.classList.remove('opacity-0', 'scale-0');
                gif.classList.remove('opacity-100', 'scale-100', 'border-green-500');
                gif.classList.add('opacity-0', 'scale-75', 'border-transparent');
            }
        });
    };

    const timelineObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.remove('opacity-0');
                entry.target.classList.add('opacity-100');
            }
        });
    }, { threshold: 0.2 });

    items.forEach(item => timelineObserver.observe(item));

    window.addEventListener('scroll', updateLine);
    window.addEventListener('resize', updateLine);
    updateLine();
</script>

{% endblock %}