{% extends 'base.html.twig' %}

{% block title %}Bachelor of Multimedia Arts{% endblock %}

{% block body %}

<style>
    html {
        scroll-behavior: smooth;
    }

    body {
        background:
            radial-gradient(circle at top left, rgba(0,131,72,0.08), transparent 25%),
            radial-gradient(circle at bottom right, rgba(254,190,16,0.10), transparent 25%),
            #f8fafc;
    }

    .scroll-section {
        scroll-margin-top: 120px;
    }

    .nav-link.active {
        background: #008348;
        color: white;
        transform: translateX(6px);
    }

    .floating-circles .circle {
        position: absolute;
        border-radius: 9999px;
        opacity: .12;
        animation: float 8s infinite ease-in-out;
    }

    .floating-circles .one {
        width: 160px;
        height: 160px;
        background: #FEBE10;
        top: -40px;
        right: -20px;
    }

    .floating-circles .two {
        width: 120px;
        height: 120px;
        background: white;
        bottom: 20px;
        left: -30px;
        animation-delay: 2s;
    }

    .floating-circles .three {
        width: 90px;
        height: 90px;
        background: #FEBE10;
        bottom: 120px;
        right: 25%;
        animation-delay: 4s;
    }

    @keyframes float {
        0%,100% {
            transform: translateY(0px);
        }
        50% {
            transform: translateY(-18px);
        }
    }

    .library-card-wrapper {
        position: relative;
        overflow: visible;
    }

    .glass-card {
        backdrop-filter: blur(12px);
        background: rgba(255,255,255);
    }
</style>

