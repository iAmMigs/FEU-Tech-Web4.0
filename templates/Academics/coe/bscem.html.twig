{% extends 'base.html.twig' %}

{% block title %}Bachelor of Science in Construction Engineering and Management{% endblock %}

{% block body %}

<style>
    html {
        scroll-behavior: smooth;
    }

    body {
        background:
            radial-gradient(circle at top left, rgba(0,131,72,0.08), transparent 25%),
            radial-gradient(circle at bottom right, rgba(254,190,16,0.10), transparent 25%),
            #f8fafc;
    }

    .scroll-section {
        scroll-margin-top: 120px;
    }

    .nav-link.active {
        background: #008348;
        color: white;
        transform: translateX(6px);
    }

    .glass-card {
        backdrop-filter: blur(12px);
        background: rgba(255,255,255);
    }
</style>

<!-- HERO -->
<section class="relative z-10 overflow-hidden border-b border-slate-100">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">

        <div class="relative group rounded-[2.5rem] overflow-hidden shadow-xl shadow-slate-200/50">

            <img src="/images/Academics/bscem.png"
                 class="w-full h-auto block transform group-hover:scale-[1.01] transition-transform duration-700 ease-out"
                 alt="Construction Engineering Hero">

            <div class="absolute inset-0 bg-gradient-to-t from-white/40 via-transparent to-transparent opacity-80"></div>

        </div>

    </div>
</section>

<main class="relative py-12">

    <div class="max-w-7xl mx-auto px-6 lg:px-10">

        <div class="grid lg:grid-cols-[300px,1fr] gap-10">

            <!-- SIDEBAR -->
            <aside class="hidden lg:block sticky top-10 self-start">

                <div class="bg-white rounded-[2.5rem] shadow-xl border border-slate-100 p-8">

                    <div class="flex items-center gap-4 mb-8">

                        <img src="/images/Tamtam/Reading_Book_Tammy.png"
                             class="w-20 object-contain"
                             alt="TamTam">

                        <div>

                            <p class="text-xs uppercase tracking-[0.3em] text-feu-green font-black">
                                FEU TECH
                            </p>

                            <h2 class="text-2xl font-black text-feu-green leading-tight">
                                BSCEM
                            </h2>

                        </div>

                    </div>

                    <nav class="space-y-3">

                        <a href="#overview"
                           class="nav-link block px-5 py-4 rounded-2xl bg-slate-100 text-feu-green font-bold transition-all duration-300">
                            Overview
                        </a>

                        <a href="#outcomes"
                           class="nav-link block px-5 py-4 rounded-2xl bg-slate-100 text-feu-green font-bold transition-all duration-300">
                            Student Outcomes
                        </a>

                        <a href="#skills"
                           class="nav-link block px-5 py-4 rounded-2xl bg-slate-100 text-feu-green font-bold transition-all duration-300">
                            Skills
                        </a>

                        <a href="#careers"
                           class="nav-link block px-5 py-4 rounded-2xl bg-slate-100 text-feu-green font-bold transition-all duration-300">
                            Career Opportunities
                        </a>

                    </nav>

                </div>

            </aside>

            <!-- CONTENT -->
            <div class="space-y-16">

                <!-- OVERVIEW -->
                <section id="overview" class="scroll-section">

                    <div class="bg-white rounded-[3rem] p-10 shadow-2xl border border-slate-100">

                        <div class="flex items-center gap-5 mb-8">

                            <img src="/images/Tamtam/Reading_Book_Tammy.png"
                                 class="w-24 object-contain"
                                 alt="TamTam">

                            <div>

                                <p class="uppercase tracking-[0.3em] text-feu-yellow font-black text-xs mb-2">
                                    Program Overview
                                </p>

                                <h2 class="text-4xl font-black text-feu-green uppercase">
                                    General Description of the Program
                                </h2>

                            </div>

                        </div>

                        <p class="text-slate-600 leading-relaxed text-lg mb-6">
                            The Bachelor of Science in Construction Engineering and Management (BS CEM) interdisciplinary program integrates engineering principles with management strategies to optimize construction projects.
                        </p>

                        <p class="text-slate-600 leading-relaxed text-lg mb-6">
                            This program equips students with expertise in project scheduling, cost estimation, risk assessment, sustainability, and construction technologies.
                        </p>

                        <p class="text-slate-600 leading-relaxed text-lg mb-6">
                            Students will gain hands-on experience with Building Information Modeling (BIM), construction safety protocols, and advanced project management tools, ensuring they are industry-ready.
                        </p>

                        <p class="text-slate-600 leading-relaxed text-lg">
                            The curriculum aligns with international standards in civil engineering and project management, preparing graduates for leadership roles in the construction sector.
                        </p>

                    </div>

                </section>

                <!-- STUDENT OUTCOMES -->
                <section id="outcomes" class="scroll-section">

                    <div class="bg-white rounded-[3rem] p-10 shadow-2xl border border-slate-100">

                        <div class="flex items-center gap-5 mb-10">

                            <img src="/images/Tamtam/Jumping_Tammy_Pencil.png"
                                 class="w-24"
                                 alt="TamTam">

                            <div>

                                <p class="uppercase tracking-[0.3em] text-feu-yellow font-black text-xs mb-2">
                                    Graduate Competencies
                                </p>

                                <h2 class="text-4xl font-black text-feu-green uppercase">
                                    Student Outcomes
                                </h2>

                            </div>

                        </div>

                        <ul class="space-y-5 text-slate-600 text-lg font-medium">

                            <li>
                                • Apply knowledge of mathematics, natural sciences, engineering fundamentals, and construction management principles to solve complex engineering problems in the construction industry.
                            </li>

                            <li>
                                • Conduct investigations of construction-related challenges using research-based knowledge, modern tools, and data-driven decision-making to optimize project performance, cost, and quality.
                            </li>

                            <li>
                                • Design construction systems, components, or processes that meet specified needs while considering public health and safety, sustainability, cultural, societal, and environmental factors.
                            </li>

                            <li>
                                • Function effectively as an individual, team member, or leader in diverse, multi-disciplinary project teams within the construction and infrastructure sectors.
                            </li>

                            <li>
                                • Identify, analyze, and formulate solutions to complex construction engineering and management problems using mathematics, engineering sciences, and project management frameworks.
                            </li>

                            <li>
                                • Uphold ethical and professional responsibilities in engineering and construction management.
                            </li>

                            <li>
                                • Communicate effectively with stakeholders through reports, presentations, technical documentation, and project meetings.
                            </li>

                            <li>
                                • Assess and evaluate the impact of construction engineering and management practices on sustainability and environmental considerations.
                            </li>

                            <li>
                                • Recognize the need for continuous learning and professional development.
                            </li>

                            <li>
                                • Apply contextual knowledge to address safety, health, legal, and cultural issues related to construction projects.
                            </li>

                            <li>
                                • Utilize modern engineering and management tools including BIM, project scheduling software, and data analytics.
                            </li>

                            <li>
                                • Demonstrate engineering management principles, financial decision-making, and project management methodologies in construction operations.
                            </li>

                            <li>
                                • Develop expertise in sustainable construction, infrastructure development, digital construction technology, and risk management.
                            </li>

                        </ul>

                    </div>

                </section>

                <!-- SKILLS -->
                <section id="skills" class="scroll-section space-y-10">

                    <div class="grid lg:grid-cols-2 gap-8">

                        <!-- SOFT SKILLS -->
                        <div class="bg-white rounded-[3rem] p-10 shadow-2xl border border-slate-100">

                            <div class="flex items-center gap-5 mb-8">

                                <img src="/images/Tamtam/Jumping_Tammy_Pencil.png"
                                     class="w-24"
                                     alt="TamTam">

                                <div>

                                    <p class="uppercase tracking-[0.3em] text-feu-yellow font-black text-xs mb-2">
                                        Graduate Competencies
                                    </p>

                                    <h2 class="text-3xl font-black text-feu-green uppercase">
                                        Soft Skills
                                    </h2>

                                </div>

                            </div>

                            <ul class="space-y-5 text-slate-600 font-medium">

                                <li>• Leadership & Team Collaboration</li>
                                <li>• Critical Thinking & Problem-Solving</li>
                                <li>• Negotiation & Conflict Resolution</li>
                                <li>• Communication & Technical Writing</li>
                                <li>• Decision-Making Under Pressure</li>
                                <li>• Adaptability to New Technologies</li>

                            </ul>

                        </div>

                        <!-- TECHNICAL SKILLS -->
                        <div class="bg-feu-green rounded-[3rem] p-10 text-white shadow-2xl">

                            <div class="flex items-center gap-5 mb-8">

                                <img src="/images/Tamtam/Reading_Book_Tammy.png"
                                     class="w-24 object-contain"
                                     alt="TamTam">

                                <div>

                                    <p class="uppercase tracking-[0.3em] text-feu-yellow font-black text-xs mb-2">
                                        Technical Competencies
                                    </p>

                                    <h2 class="text-3xl font-black uppercase">
                                        Technical Skills
                                    </h2>

                                </div>

                            </div>

                            <ul class="space-y-3 text-white/90 font-medium">

                                <li>• Construction Planning & Scheduling</li>
                                <li>• Structural Systems & Design</li>
                                <li>• Cost Estimation & Budgeting</li>
                                <li>• Risk Management & Safety Compliance</li>
                                <li>• Sustainable Construction Practices</li>
                                <li>• Building Information Modeling (BIM)</li>
                                <li>• Construction Law & Contract Management</li>
                                <li>• Quality Assurance & Control</li>

                            </ul>

                        </div>

                    </div>

                </section>

                <!-- CAREERS -->
                <section id="careers" class="scroll-section">

                    <div class="bg-white rounded-[3rem] p-10 shadow-2xl border border-slate-100">

                        <div class="flex items-center gap-5 mb-8">

                            <img src="/images/Tamtam/Jumping_Tammy_Pencil.png"
                                 class="w-24"
                                 alt="TamTam">

                            <div>

                                <p class="uppercase tracking-[0.3em] text-feu-yellow font-black text-xs mb-2">
                                    Construction Engineering
                                </p>

                                <h2 class="text-4xl font-black text-feu-green uppercase">
                                    Career Opportunities
                                </h2>

                            </div>

                        </div>

                        <div class="bg-feu-green rounded-[2rem] p-8">

                            <h3 class="text-2xl font-black text-feu-yellow mb-6 uppercase">
                                Career Paths
                            </h3>

                            <ul class="grid md:grid-cols-2 gap-x-8 gap-y-3 text-white font-medium">

                                <li>• Construction Engineer</li>
                                <li>• Project Manager</li>
                                <li>• Site Engineer</li>
                                <li>• Cost Estimator</li>
                                <li>• Contracts & Procurement Engineer</li>
                                <li>• Infrastructure Development Manager</li>
                                <li>• Building Information Modeling (BIM) Specialist</li>

                            </ul>

                        </div>

                    </div>

                </section>

            </div>

        </div>

    </div>

</main>

<script>
    const navLinks = document.querySelectorAll('.nav-link');
    const sections = document.querySelectorAll('.scroll-section');

    navLinks.forEach(link => {
        link.addEventListener('click', function (e) {
            e.preventDefault();

            const target = document.querySelector(this.getAttribute('href'));

            target.scrollIntoView({
                behavior: 'smooth',
                block: 'start'
            });
        });
    });

    function updateActiveLink() {
        let currentSection = '';

        sections.forEach(section => {
            const rect = section.getBoundingClientRect();

            if (rect.top <= 200 && rect.bottom >= 200) {
                currentSection = section.id;
            }
        });

        navLinks.forEach(link => {
            link.classList.remove('active');

            if (link.getAttribute('href') === `#${currentSection}`) {
                link.classList.add('active');
            }
        });
    }

    window.addEventListener('scroll', updateActiveLink);

    updateActiveLink();
</script>

{% endblock %}