{% extends 'base.html.twig' %}

{% block title %}Bachelor of Science in Civil Engineering{% endblock %}

{% block body %}

<style>

    html {
        scroll-behavior: smooth;
    }

    body {
        background:
            radial-gradient(circle at top left, rgba(0,131,72,0.08), transparent 25%),
            radial-gradient(circle at bottom right, rgba(254,190,16,0.10), transparent 25%),
            #f8fafc;
    }

    .scroll-section {
        scroll-margin-top: 120px;
    }

    .nav-link.active {
        background: #008348;
        color: white;
        transform: translateX(6px);
    }

    .glass-card {
        backdrop-filter: blur(14px);
        background: rgba(255,255,255,.72);
    }

    .faculty-card {
        transition:
            transform .35s ease,
            box-shadow .35s ease;
    }

    .faculty-card:hover {
        transform: translateY(-8px);

        box-shadow:
            0 20px 50px rgba(0,131,72,.18),
            0 10px 30px rgba(254,190,16,.12);
    }

    .blueprint-bg {
        background-image:
            linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px);

        background-size: 24px 24px;
    }

    /* FLOATING */

    .float-animation {
        animation: floating 5s ease-in-out infinite;
    }

    @keyframes floating {

        0%,100% {
            transform: translateY(0px);
        }

        50% {
            transform: translateY(-14px);
        }
    }

    /* CARD HOVER */

    .glow-hover {
        transition:
            transform .35s ease,
            box-shadow .35s ease;
    }

    .glow-hover:hover {

        transform: translateY(-8px);

        box-shadow:
            0 20px 50px rgba(0,131,72,.18),
            0 10px 30px rgba(254,190,16,.12);
    }

    /* SHIMMER EFFECT */

    .shimmer {
        position: relative;
        overflow: hidden;
    }

    .shimmer::before {

        content: '';

        position: absolute;

        top: 0;
        left: -120%;

        width: 70%;
        height: 100%;

        background: linear-gradient(
            90deg,
            transparent,
            rgba(255,255,255,.25),
            transparent
        );

        transform: skewX(-20deg);
    }

    .shimmer:hover::before {
        animation: shimmerMove 1.1s ease;
    }

    @keyframes shimmerMove {

        100% {
            left: 160%;
        }
    }

    /* ENGINEERING COMPETENCIES */

    .competency-pill {

        border: 2px solid #008348;

        background: white;

        color: #008348;

        transition:
            all .35s ease,
            box-shadow .35s ease;
    }

    .competency-pill:hover {

        background: #008348;

        color: white;

        box-shadow:
            0 15px 30px rgba(0,131,72,.22);
    }

      /* ENGINEERING COMPETENCIES */

    .careers-pill {

        border: 2px solid #febe10;

        background: white;

        color: #5b5c5c;

        transition:
            all .35s ease,
            box-shadow .35s ease;
        
    }

    .careers-pill:hover {

        background: #febe10;

        color: white;

        box-shadow:
            0 15px 30px rgba(0,131,72,.22);
    }

    /* LAB IMAGE HOVER */

    .lab-image {
        transition:
            transform .6s ease,
            filter .4s ease;
    }

    .lab-image:hover {
        transform: scale(1.03);
        filter: brightness(1.04);
    }

</style>

<!-- HERO -->
<section class="relative z-10 overflow-hidden border-b border-slate-100">

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">

        <div class="relative group rounded-[2.5rem] overflow-hidden shadow-xl shadow-slate-200/50">

            <img src="/images/Academics/bsce.png"
                 class="w-full h-auto block transform group-hover:scale-[1.02] transition-transform duration-700 ease-out"
                 alt="Civil Engineering Hero">

            <div class="absolute inset-0 bg-gradient-to-t from-black/30 via-transparent to-transparent"></div>

        </div>

    </div>

</section>

<main class="relative py-12">

    <div class="max-w-7xl mx-auto px-6 lg:px-10">

        <div class="grid lg:grid-cols-[300px,1fr] gap-10">

            <!-- SIDEBAR -->
