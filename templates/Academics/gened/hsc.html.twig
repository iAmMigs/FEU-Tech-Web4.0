{% extends 'base.html.twig' %}

{% block title %}Humanities, Social Sciences and Communication{% endblock %}

{% block body %}

<style>

    html {
        scroll-behavior: smooth;
    }

    body {
        background:
            radial-gradient(circle at top left, rgba(0,131,72,0.08), transparent 25%),
            radial-gradient(circle at bottom right, rgba(254,190,16,0.10), transparent 25%),
            #f8fafc;
    }

    .scroll-section {
        scroll-margin-top: 120px;
    }

    .nav-link.active {
        background: #008348;
        color: white;
        transform: translateX(6px);
    }

    .glass-card {
        backdrop-filter: blur(14px);
        background: rgba(255,255,255,.72);
    }

    .float-animation {
        animation: floating 5s ease-in-out infinite;
    }

    @keyframes floating {

        0%,100% {
            transform: translateY(0px);
        }

        50% {
            transform: translateY(-14px);
        }
    }

    .glow-hover {
        transition:
            transform .35s ease,
            box-shadow .35s ease;
    }

    .glow-hover:hover {

        transform: translateY(-8px);

        box-shadow:
            0 20px 50px rgba(0,131,72,.18),
            0 10px 30px rgba(254,190,16,.12);
    }

    .competency-pill {

        border: 2px solid #008348;

        background: white;

        color: #008348;

        transition:
            all .35s ease,
            box-shadow .35s ease;
    }

    .competency-pill:hover {

        background: #008348;

        color: white;

        box-shadow:
            0 15px 30px rgba(0,131,72,.22);
    }

</style>

<!-- HERO -->
<section class="relative z-10 overflow-hidden border-b border-slate-100">

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">

        <div class="relative group rounded-[2.5rem] overflow-hidden shadow-xl shadow-slate-200/50">

            <img src="/images/Academics/mps.jpg"
                 class="w-full h-auto block transform group-hover:scale-[1.02] transition-transform duration-700 ease-out"
                 alt="HSC Hero">

            <div class="absolute inset-0 bg-gradient-to-t from-black/30 via-transparent to-transparent"></div>

        </div>

    </div>

</section>

<main class="relative py-12">

    <div class="max-w-7xl mx-auto px-6 lg:px-10">

        <div class="grid lg:grid-cols-[300px,1fr] gap-10">

            <!-- SIDEBAR -->
            <aside class="hidden lg:block sticky top-10 self-start">

                <div class="bg-white rounded-[2.5rem] shadow-xl border border-slate-100 p-8">

                    <div class="flex items-center gap-4 mb-8">

                        <img src="/images/Tamtam/Reading_Book_Tammy.png"
                             class="w-20 object-contain float-animation"
                             alt="TamTam">

                        <div>

                            <p class="text-xs uppercase tracking-[0.3em] text-feu-green font-black">
                                FEU TECH
                            </p>

                            <h2 class="text-2xl font-black text-feu-green">
                                HSC
                            </h2>

                        </div>

                    </div>

                    <nav class="space-y-3">

                        <a href="#overview" class="nav-link block px-5 py-4 rounded-2xl bg-slate-100 text-feu-green font-bold transition-all duration-300">
                            Overview
                        </a>

                        <a href="#units" class="nav-link block px-5 py-4 rounded-2xl bg-slate-100 text-feu-green font-bold transition-all duration-300">
                            Sub Units
                        </a>

                        <a href="#contact" class="nav-link block px-5 py-4 rounded-2xl bg-slate-100 text-feu-green font-bold transition-all duration-300">
                            Contact
                        </a>

                    </nav>

                </div>

            </aside>

            <!-- CONTENT -->
            <div class="space-y-16">

                <!-- OVERVIEW -->
                <section id="overview" class="scroll-section">

                    <div class="bg-white rounded-[3rem] p-10 shadow-2xl border border-slate-100 glow-hover">

                        <div class="flex items-center gap-5 mb-8">

                            <img src="/images/Tamtam/Reading_Book_Tammy.png"
                                 class="w-24 object-contain float-animation"
                                 alt="TamTam">

                            <div>

                                <p class="uppercase tracking-[0.3em] text-feu-yellow font-black text-xs mb-2">
                                    Department Overview
                                </p>

                                <h2 class="text-4xl font-black text-feu-green uppercase">
                                    General Information
                                </h2>

                            </div>

                        </div>

                        <p class="text-slate-600 leading-relaxed text-lg mb-6">
                            With the goal of elevating the competency of each student, the HSC Department of FEU Institute of Technology extends its expertise to contribute to the overall development of students through a set of knowledge areas and values integration.
                        </p>

                        <p class="text-slate-600 leading-relaxed text-lg">
                            As a service department, it also provides general requirements to the curricular offerings of the College in the following sub units:
                        </p>

                    </div>

                </section>

                <!-- SUB UNITS -->
                <section id="units" class="scroll-section">

                    <div class="bg-white rounded-[3rem] p-10 shadow-2xl border border-slate-100 glow-hover">

                        <div class="flex items-center gap-4 mb-8">

                            <img src="/images/Tamtam/Jumping_Tammy_Pencil.png"
                                 class="w-24"
                                 alt="TamTam">

                            <div>

                                <p class="uppercase tracking-[0.3em] text-feu-yellow font-black text-xs mb-2">
                                    Academic Areas
                                </p>

                                <h2 class="text-4xl font-black text-feu-green uppercase">
                                    Sub Units
                                </h2>

                            </div>

                        </div>

                        <div class="flex flex-wrap gap-4">

                            {% set units = [
                                'Humanities',
                                'Social Sciences',
                                'Communication',
                                'Filipino',
                                'English',
                                'Foreign Language Courses',
                                'Physical Education',
                                'National Service Training Program (NSTP)'
                            ] %}

                            {% for item in units %}

                                <div class="competency-pill px-6 py-4 rounded-full font-bold shadow-md">
                                    {{ item }}
                                </div>

                            {% endfor %}

                        </div>

                    </div>

                </section>

                <!-- CONTACT -->
                <section id="contact" class="scroll-section">

                    <div class="bg-feu-green rounded-[3rem] p-12 text-white relative overflow-hidden">

                        <div class="absolute bottom-0 right-0 opacity-10">
                            <img src="/images/Tamtam/Jumping_Tammy_Pencil.png"
                                 class="w-80"
                                 alt="TamTam">
                        </div>

                        <div class="relative z-10">

                            <p class="uppercase tracking-[0.3em] text-feu-yellow font-black text-xs mb-3">
                               Humanities, Social Sciences and Communication Department
                            </p>

                            <h2 class="text-5xl font-black uppercase mb-10">
                                Contact Details
                            </h2>

                            <div class="grid md:grid-cols-2 gap-10">

                                <div class="space-y-5">

                                    <div>
                                        <p class="text-feu-yellow font-black uppercase text-xs tracking-widest mb-1">
                                            Office
                                        </p>

                                        <p class="text-xl">
                                            Room 506
                                        </p>
                                    </div>

                                    <div>
                                        <p class="text-feu-yellow font-black uppercase text-xs tracking-widest mb-1">
                                            Office Hours
                                        </p>

                                        <p class="text-xl">
                                            Monday to Friday <br>
                                            8:00 a.m. ─ 5:00 p.m.
                                        </p>
                                    </div>

                                    <div>
                                        <p class="text-feu-yellow font-black uppercase text-xs tracking-widest mb-1">
                                            Trunkline
                                        </p>

                                        <p class="text-xl">
                                            (02) 8281 8888 Local 425
                                        </p>
                                    </div>

                                    <div>
                                        <p class="text-feu-yellow font-black uppercase text-xs tracking-widest mb-1">
                                            Email
                                        </p>

                                        <p class="text-xl text-feu-yellow">
                                            <a href="mailto:hsc@feutech.edu.ph"
                                            class="hover:text-white transition-colors duration-300 underline underline-offset-4">
                                                hsc@feutech.edu.ph
                                            </a>
                                        </p>
                                    </div>

                                </div>

                                <div class="glass-card rounded-[2rem] p-8 text-feu-green relative overflow-hidden">
    
                                    <img src="/images/Tamtam/Wave_Tammy.png"
                                        class="absolute bottom-0 right-0 w-40 opacity-40 pointer-events-none select-none"
                                        alt="TamTam background">

                                    <p class="uppercase tracking-[0.3em] text-feu-green font-black text-xs mb-3">
                                        Director
                                    </p>

                                    <h3 class="text-3xl font-black text-black uppercase mb-3">
                                        MA. RUTH S. QUE
                                    </h3>

                                    <p class="text-slate-600 leading-relaxed">
                                        Director of Humanities, Social Sciences, and Communication
                                    </p>
                                </div>

                            </div>
                        </div>
                    </div>

                </section>

            </div>

        </div>

    </div>

</main>

<script>

    const navLinks = document.querySelectorAll('.nav-link');
    const sections = document.querySelectorAll('.scroll-section');

    navLinks.forEach(link => {

        link.addEventListener('click', function (e) {

            e.preventDefault();

            const target = document.querySelector(this.getAttribute('href'));

            target.scrollIntoView({
                behavior: 'smooth',
                block: 'start'
            });

        });

    });

    function updateActiveLink() {

        let currentSection = '';

        sections.forEach(section => {

            const rect = section.getBoundingClientRect();

            if (rect.top <= 200 && rect.bottom >= 200) {
                currentSection = section.id;
            }

        });

        navLinks.forEach(link => {

            link.classList.remove('active');

            if (link.getAttribute('href') === `#${currentSection}`) {
                link.classList.add('active');
            }

        });

    }

    window.addEventListener('scroll', updateActiveLink);

    updateActiveLink();

</script>

{% endblock %}